---
import Layout from '../../layouts/Layout.astro'
---

<Layout title="Our Team - Roomieverse Labs" lang="en">
  <main>
    <section style="padding: 180px 20px 80px; max-width: 1200px; margin: 0 auto; text-align: center;">
      <h1 style="font-size: clamp(3rem, 6vw, 5rem); color: var(--ink);">Our Team</h1>
    </section>

    <section style="padding: 0 20px 120px; max-width: 1200px; margin: 0 auto;">
      <div style="display: flex; justify-content: center; gap: 80px; flex-wrap: wrap;">
        <!-- Member 1 -->
        <article class="reveal" style="display: flex; flex-direction: column; align-items: center; text-align: center; width: 260px;">
          <div style="width: 180px; height: 180px; border-radius: 50%; background: #e5e5ea; margin-bottom: 24px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
            <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#aeaeb2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          </div>
          <h3 style="margin-bottom: 4px; font-size: 1.8rem; color: var(--ink);">[ Name ]</h3>
          <p style="color: var(--muted); font-size: 1rem; margin-bottom: 16px;">@[ username ]</p>
          <p style="color: var(--blue); font-weight: 600; font-size: 1.1rem; margin-bottom: 16px;">[ Position / Role ]</p>
          <div style="display: flex; gap: 12px; color: var(--muted);">
            <a href="#" style="color: inherit; text-decoration: none;">X</a>
            <a href="#" style="color: inherit; text-decoration: none;">LinkedIn</a>
          </div>
        </article>

        <!-- Member 2 -->
        <article class="reveal" style="transition-delay: 0.1s; display: flex; flex-direction: column; align-items: center; text-align: center; width: 260px;">
          <div style="width: 180px; height: 180px; border-radius: 50%; background: #e5e5ea; margin-bottom: 24px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
            <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#aeaeb2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          </div>
          <h3 style="margin-bottom: 4px; font-size: 1.8rem; color: var(--ink);">[ Name ]</h3>
          <p style="color: var(--muted); font-size: 1rem; margin-bottom: 16px;">@[ username ]</p>
          <p style="color: var(--blue); font-weight: 600; font-size: 1.1rem; margin-bottom: 16px;">[ Position / Role ]</p>
          <div style="display: flex; gap: 12px; color: var(--muted);">
            <a href="#" style="color: inherit; text-decoration: none;">X</a>
            <a href="#" style="color: inherit; text-decoration: none;">LinkedIn</a>
          </div>
        </article>
        
        <!-- Member 3 -->
        <article class="reveal" style="transition-delay: 0.2s; display: flex; flex-direction: column; align-items: center; text-align: center; width: 260px;">
          <div style="width: 180px; height: 180px; border-radius: 50%; background: #e5e5ea; margin-bottom: 24px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
            <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#aeaeb2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          </div>
          <h3 style="margin-bottom: 4px; font-size: 1.8rem; color: var(--ink);">[ Name ]</h3>
          <p style="color: var(--muted); font-size: 1rem; margin-bottom: 16px;">@[ username ]</p>
          <p style="color: var(--blue); font-weight: 600; font-size: 1.1rem; margin-bottom: 16px;">[ Position / Role ]</p>
          <div style="display: flex; gap: 12px; color: var(--muted);">
            <a href="#" style="color: inherit; text-decoration: none;">X</a>
            <a href="#" style="color: inherit; text-decoration: none;">LinkedIn</a>
          </div>
        </article>
      </div>
    </section>
  </main>
</Layout>
