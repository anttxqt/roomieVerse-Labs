---
import '../../styles/global.css'
import RoomieverseLabsLogo from '../../components/RoomieverseLabsLogo.astro'
import Layout from '../../layouts/Layout.astro'

const products = [
  {
    name: 'roomio',
    role: 'Rental operations & management',
    description: 'For landlords managing buildings, rooms, tenants, contracts, invoices, payments, maintenance issues, and staff — all in one place. Automated monthly reminders and bills.',
    logo: '/brand/roomio.png',
    logoAlt: 'Roomio',
    titleLogo: '/brand/roomio.png',
    accent: 'blue',
    metrics: ['Buildings', 'Contracts', 'Invoices'],
    link: '/en/roomio',
    linkText: 'Learn more',
  },
  {
    name: 'roomieverse',
    role: 'Find a room & a roommate',
    description: 'For students and people working away from home looking for a roommate who matches their lifestyle. Find a shared room in an apartment or a house — all direct, no agents involved.',
    logo: '/brand/roomieverse-cropped.png',
    logoAlt: 'Roomieverse',
    titleLogo: '/brand/roomieverse.png',
    accent: 'pink',
    metrics: ['Find a room', 'Find a roommate', 'Shared spaces'],
    link: '/en/roomieverse',
    linkText: 'Learn more',
  },
  {
    name: 'roomibase',
    role: 'Find a place, direct',
    description: 'For people looking to rent a whole room, house, or apartment — through an agent or straight from the landlord.',
    logo: '/brand/roomibase-rounded.png',
    logoAlt: 'Roomibase',
    titleLogo: '/brand/roomibase-rounded.png',
    accent: 'navy',
    metrics: ['Landlords', 'Tenants', 'Places'],
    comingSoon: true,
    link: '/en/roomieverse',
    linkText: 'Learn more',
  },
]

const journey = [
  ['01', 'Find a place', 'Roomibase connects renters directly with landlords to browse listings that fit.'],
  ['02', 'Also about finding a place, but...', 'Roomieverse matches you with a roommate based on habits and lifestyle.'],
  ['03', 'Effortless operations', 'Roomio helps landlords manage everything once a room is occupied.'],
]
---

<Layout lang="en">
    <div class="preloader" aria-hidden="true">
      <div class="preloader-content">
        <div class="preloader-logos">
          <img class="preloader-logo preloader-logo--roomio" src="/brand/roomio.png" width="611" height="176" alt="" />
          <span class="preloader-divider"></span>
          <img class="preloader-logo preloader-logo--verse" src="/brand/roomieverse-stacked-cropped.png" width="813" height="397" alt="" />
          <span class="preloader-divider"></span>
          <img class="preloader-logo preloader-logo--base" src="/brand/roomibase-rounded.png" width="1603" height="308" alt="" />
        </div>
        <div class="preloader-credit"><RoomieverseLabsLogo /></div>
      </div>
    </div>

    <header class="topbar" aria-label="Main navigation">
      <a class="brand" href="#hero" aria-label="RoomieVerse Labs — back to top">
        <RoomieverseLabsLogo />
      </a>
      <div class="topbar-actions">
        <div class="lang-switch">
          <a href="/">VI</a>
          <span class="lang-sep">|</span>
          <a href="/en/" class="is-active">EN</a>
        </div>
        <button class="menu-button" type="button" aria-expanded="false" aria-controls="main-menu"><span>Menu</span><i aria-hidden="true"></i></button>
      </div>
    </header>

    <aside class="menu-overlay" id="main-menu" aria-hidden="true">
      <div class="menu-head">
        <div class="menu-logos">
          <img class="menu-logo menu-logo--roomio" src="/brand/roomio.png" width="611" height="176" alt="" />
          <span class="menu-divider"></span>
          <img class="menu-logo menu-logo--verse" src="/brand/roomieverse-stacked-cropped.png" width="813" height="397" alt="" />
          <span class="menu-divider"></span>
          <img class="menu-logo menu-logo--base" src="/brand/roomibase-rounded.png" width="1603" height="308" alt="" />
        </div>
        <button class="menu-close" type="button" aria-label="Close menu">×</button>
      </div>
      <div class="menu-body">
        <nav aria-label="Site menu">
          <a href="#hero"><span>01</span>Home</a>
          <a href="#products"><span>02</span>roomio</a>
          <a href="#products"><span>03</span>roomieVerse</a>
          <a href="#products"><span>04</span>roomibase</a>
          <a href="#footer"><span>05</span>Our Team</a>
        </nav>
        <a class="brand brand--blue menu-brand" href="#hero" tabindex="-1">
          <RoomieverseLabsLogo />
        </a>
      </div>
      <div class="menu-orbits" aria-hidden="true"><i></i><i></i><i></i></div>
    </aside>

    <main>
      <section class="hero-scroll" id="hero">
        <div class="hero-frame">
          <div class="hero-shell">
            <div class="hero-copy">
              <h1>Make <em>renting</em> and <em>hosting</em> a home<br />feel <strong style="color: var(--pink); font-size: 1.15em; font-weight: 900;">better.</strong></h1>
            </div>

            <div class="scroll-cue"><span>Scroll to explore</span><i>↓</i></div>
          </div>
        </div>
      </section>

      <section class="menu-section">
        <div class="topping-heading reveal" id="story">
          <h3>A seamless journey</h3>
          <p><mark>roomieVerse Labs</mark> walks with you through every step of finding a place —<br />from settling in as a tenant to managing it with ease as a host.</p>
        </div>
        <div class="toppings-grid journey-grid">
          {journey.map(([number, title, description], index) => (
            <article class={`topping-card journey-card journey-card--${index + 1} reveal`}><span>{number}</span><i aria-hidden="true"></i><h3>{title}</h3><p>{description}</p></article>
          ))}
        </div>

        <div class="section-title reveal" id="products" aria-labelledby="products-title">
          <h2 id="products-title">So<span style="color: var(--roomibase)">,</span> what do we have<span style="color: var(--pink)">?</span></h2>
        </div>

        <div class="dish-list product-list">
          {products.map((product, index) => (
            <article class={`dish-card product-card product-card--${product.accent} reveal`}>
              <div class="product-visual">
                <img src={product.logo} class="product-hero-logo" alt="" aria-hidden="true" />
              </div>
              <div class="dish-copy">
                <small>
                  {product.role}
                  {product.comingSoon && <span class="badge badge--coming-soon">In development</span>}
                </small>
                <p>{product.description}</p>
                <div style="margin-top: 16px; display: flex; gap: 16px; flex-wrap: wrap; align-items: center;">
                  {product.link && (
                    <a href={product.link} class="learn-more-link">
                      <span class="lml-text">{product.linkText}</span>
                      <span class="lml-arrow" aria-hidden="true">→</span>
                    </a>
                  )}
                  {product.comingSoon && (
                    <a href="#footer" class="product-action" style="margin-top: 0;"><span>Notify me</span></a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>
</Layout>
