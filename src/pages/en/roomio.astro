---
import Layout from '../../layouts/Layout.astro'
import RoomieverseLabsLogo from '../../components/RoomieverseLabsLogo.astro'
---

<Layout title="roomio · Property management & operations">
  <main>
    <section class="keynote-bento-section" style="padding-top: 120px; min-height: 100vh;">
      <div class="keynote-grid">
        <!-- Centerpiece -->
        <article class="keynote-card keynote-card--centerpiece keynote-card--col-4 keynote-card--row-2 reveal">
          <h3>roomio</h3>
        </article>

        <!-- Big Text Card -->
        <article class="keynote-card keynote-card--text-hero keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.1s;">
          <h3 class="keynote-gradient-text">FULLY<br/>AUTOMATED</h3>
          <p style="margin-top: 12px;">Calculate bills & send reminders on time, every time.</p>
        </article>

        <!-- Small Chip 1 -->
        <article class="keynote-card keynote-card--chip keynote-card--col-2 reveal" style="transition-delay: 0.2s;">
          <div class="keynote-chip-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          </div>
          <h3>Smart Contracts</h3>
        </article>

        <!-- Small Chip 2 -->
        <article class="keynote-card keynote-card--chip keynote-card--col-2 reveal" style="transition-delay: 0.25s;">
          <div class="keynote-chip-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </div>
          <h3>Staff Roles</h3>
        </article>

        <!-- Small Chip 3 -->
        <article class="keynote-card keynote-card--chip keynote-card--col-2 reveal" style="transition-delay: 0.3s;">
          <div class="keynote-chip-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
          </div>
          <h3>Issue Tracking</h3>
        </article>

        <!-- Wide Image Card -->
        <article class="keynote-card keynote-card--col-6 reveal" style="transition-delay: 0.35s; align-items: center; justify-content: center; min-height: 250px; background: #e3e3e8;">
          <span style="color: #1d1d1f; font-weight: bold; opacity: 0.3; font-size: 1.5rem;">[ Dashboard or Mobile App Mockup ]</span>
        </article>
      </div>
    </section>
  </main>
</Layout>
