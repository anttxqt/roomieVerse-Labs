---
import Layout from '../../layouts/Layout.astro'
import RoomieverseLabsLogo from '../../components/RoomieverseLabsLogo.astro'
---

<Layout title="roomio · Property management & operations">
  <main>
    <section class="apple-bento-section">
      <div class="section-title reveal" style="text-align: center; margin-bottom: 60px;">
        <h2 style="font-size: clamp(3rem, 6vw, 5rem); color: #fff;">roomio</h2>
        <p style="margin-top: 24px; font-size: 1.25rem; color: #a1a1a6; max-width: 600px; margin-inline: auto;">
          The all-in-one toolkit that frees up your time and simplifies property operations.
        </p>
      </div>

      <div class="apple-grid">
        <!-- Main Feature (Large) -->
        <article class="apple-card apple-card--span-4 apple-card--row-2 reveal">
          <h3 class="apple-gradient-text">ALL-IN-ONE.</h3>
          <p>All rooms, tenants, contracts, and invoices on a single screen.</p>
          <div class="apple-visual">
            <span style="color: #fff; font-weight: bold; opacity: 0.2; font-size: 1.5rem;">[ roomio Dashboard Mockup ]</span>
            <div class="apple-visual-edge"></div>
          </div>
        </article>

        <!-- Secondary Feature (Normal) -->
        <article class="apple-card apple-card--span-2 reveal" style="transition-delay: 0.1s;">
          <h3 class="apple-gradient-text--blue">Automated.</h3>
          <p>The system automatically calculates utility bills and sends monthly payment reminders to tenants.</p>
        </article>

        <!-- Secondary Feature (Normal) -->
        <article class="apple-card apple-card--span-2 reveal" style="transition-delay: 0.2s;">
          <h3 class="apple-gradient-text--green">Digitalized.</h3>
          <p>Sign and manage digital contracts. Automatically alerts you before a contract expires.</p>
        </article>

        <!-- Wide Feature (Wide) -->
        <article class="apple-card apple-card--span-3 reveal">
          <h3>Maintenance & Issues</h3>
          <p>Receive and track the progress of maintenance requests directly from tenants within the app.</p>
          <div class="apple-visual" style="min-height: 120px;">
            <span style="color: #fff; font-weight: bold; opacity: 0.2;">[ Issue Report Mockup ]</span>
          </div>
        </article>

        <!-- Normal Feature (Normal) -->
        <article class="apple-card apple-card--span-3 reveal">
          <h3>Staff Roles & Permissions</h3>
          <p>Securely assign specific management permissions to individual staff members for specific buildings.</p>
        </article>
      </div>
    </section>
  </main>
</Layout>
