---
import Layout from '../../layouts/Layout.astro'
import RoomieverseLabsLogo from '../../components/RoomieverseLabsLogo.astro'
---

<Layout title="roomio · Property management & operations">
  <main>
    <section class="menu-section" style="padding-top: 150px; min-height: 100vh;">
      <div class="section-title reveal" id="hero">
        <h2 style="font-size: clamp(3rem, 6vw, 5rem);">roomio</h2>
        <p style="margin-top: 24px; font-size: 1.25rem; color: var(--muted); max-width: 600px; margin-inline: auto;">
          The all-in-one toolkit that frees up your time and simplifies property operations.
        </p>
      </div>

      <div class="bento-grid">
        <!-- Main Feature (Large) -->
        <article class="bento-card bento-card--large bento-card--navy reveal">
          <h3>Centralized Management</h3>
          <p>All rooms, tenants, contracts, and invoices on a single screen. Easily track and monitor your business performance in real-time.</p>
          <div class="bento-visual">
            <span style="color: var(--blue-dark); font-weight: bold; opacity: 0.5;">[ roomio Dashboard Mockup ]</span>
          </div>
        </article>

        <!-- Secondary Feature (Normal) -->
        <article class="bento-card reveal" style="transition-delay: 0.1s;">
          <h3>Automated Reminders</h3>
          <p>The system automatically calculates utility bills and sends monthly payment reminders via Zalo or Email to tenants.</p>
          <div class="bento-visual">
            <span style="color: var(--blue-dark); font-weight: bold; opacity: 0.5;">[ Notification Mockup ]</span>
          </div>
        </article>

        <!-- Secondary Feature (Normal) -->
        <article class="bento-card reveal" style="transition-delay: 0.2s;">
          <h3>Smart Contracts</h3>
          <p>Sign and manage digital contracts. Automatically alerts you before a contract is about to expire.</p>
          <div class="bento-visual">
            <span style="color: var(--blue-dark); font-weight: bold; opacity: 0.5;">[ Contract Mockup ]</span>
          </div>
        </article>

        <!-- Wide Feature (Wide) -->
        <article class="bento-card bento-card--wide reveal">
          <h3>Maintenance & Issues</h3>
          <p>Receive and track the progress of maintenance requests directly from tenants within the app.</p>
          <div class="bento-visual" style="min-height: 120px;">
            <span style="color: var(--blue-dark); font-weight: bold; opacity: 0.5;">[ Issue Report Mockup ]</span>
          </div>
        </article>

        <!-- Normal Feature (Normal) -->
        <article class="bento-card reveal">
          <h3>Staff Roles & Permissions</h3>
          <p>Securely assign specific management permissions to individual staff members for specific buildings.</p>
        </article>
      </div>
    </section>
  </main>
</Layout>
