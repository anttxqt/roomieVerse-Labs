---
import Layout from '../../layouts/Layout.astro'
import RoomieverseLabsLogo from '../../components/RoomieverseLabsLogo.astro'
---

<Layout title="roomieverse & roomibase · Find your next place" lang="en">
  <main>
    <section class="menu-section" style="padding-top: 150px; min-height: 80vh;">

      <!-- roomieverse section -->
      <div class="section-title reveal" id="roomieverse">
        <h2>roomie<span style="color: var(--pink-ink);">verse</span></h2>
        <p style="margin-top: 20px; font-size: 1.2rem; color: var(--muted); max-width: 600px; margin-inline: auto;">
          Find a room to share — find a roommate
        </p>
      </div>

      <div class="dish-list" style="margin-top: 60px;">
        <article class="dish-card product-card product-card--pink reveal" style="grid-template-columns: 1fr;">
          <div class="dish-copy" style="text-align: center; max-width: 800px; margin: 0 auto;">
            <p>
              For students and people working away from home looking for a roommate who matches their lifestyle. Find a shared room in an apartment or a house. All direct, no agents involved.
            </p>
          </div>
          <div class="product-visual" style="margin-top: 40px; border-radius: 20px; box-shadow: 0 20px 40px var(--line);">
            <div style="background: var(--pink-soft); width: 100%; aspect-ratio: 16/9; display: flex; align-items: center; justify-content: center; border-radius: inherit;">
              <span style="color: var(--pink-ink); font-weight: bold; font-size: 1.5rem;">[ Roommate matching illustration ]</span>
            </div>
          </div>
        </article>
      </div>

      <!-- Divider -->
      <hr style="margin: 120px auto; max-width: 200px; border: 0; border-top: 2px dashed var(--line);" />

      <!-- roomibase section -->
      <div class="section-title reveal" id="roomibase">
        <h2>roomi<span style="color: var(--roomibase);">base</span></h2>
        <p style="margin-top: 20px; font-size: 1.2rem; color: var(--muted); max-width: 600px; margin-inline: auto;">
          Find rooms & homes for rent
        </p>
      </div>

      <div class="dish-list" style="margin-top: 60px;">
        <article class="dish-card product-card product-card--navy reveal" style="grid-template-columns: 1fr;">
          <div class="dish-copy" style="text-align: center; max-width: 800px; margin: 0 auto;">
            <p>
              For people looking to rent a whole room, house, or apartment — through an agent or straight from the landlord.
            </p>
            <span class="badge badge--coming-soon" style="margin-top: 20px; display: inline-block;">In development</span>
          </div>
          <div class="product-visual" style="margin-top: 40px; border-radius: 20px; box-shadow: 0 20px 40px var(--line);">
            <div style="background: var(--roomibase-soft); width: 100%; aspect-ratio: 16/9; display: flex; align-items: center; justify-content: center; border-radius: inherit;">
              <span style="color: var(--roomibase-dark); font-weight: bold; font-size: 1.5rem;">[ Coming soon ]</span>
            </div>
          </div>
        </article>
      </div>

    </section>
  </main>
</Layout>
