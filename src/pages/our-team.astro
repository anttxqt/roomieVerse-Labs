---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Đội ngũ - roomieVerse Labs">
  <main>
    <section style="padding: 180px 20px 80px; max-width: 1000px; margin: 0 auto; text-align: center;">
      <h1 style="font-size: clamp(3rem, 6vw, 5rem); color: var(--ink);">Đội ngũ của chúng tôi</h1>
    </section>

    <section style="padding: 0 20px 120px; max-width: 1000px; margin: 0 auto;">
      <div style="display: flex; flex-direction: column; gap: 40px;">
        <!-- Member 1 -->
        <article style="display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; padding: 40px; background: #f5f5f7; border-radius: 32px; gap: 40px;">
          <div style="display: flex; align-items: flex-start; gap: 32px; flex: 1; min-width: 280px;">
            <div style="width: 110px; height: 110px; border-radius: 50%; background: #e5e5ea; flex-shrink: 0; overflow: hidden; display: flex; align-items: center; justify-content: center;">
              <svg width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="#aeaeb2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            </div>
            <div style="display: flex; flex-direction: column; gap: 16px; padding-top: 6px;">
              <h3 style="margin: 0; font-size: 2rem; color: var(--ink); line-height: 1;">An T. Tran</h3>
              <p style="margin: 0; color: var(--muted); font-size: 1.1rem; line-height: 1;">@antt</p>
              <div style="display: flex; gap: 12px; color: var(--muted); line-height: 1;">
                <a href="https://x.com/2uehi" target="_blank" style="color: inherit; text-decoration: none;">X (@2uehi)</a>
              </div>
            </div>
          </div>
          <div style="flex: 1.5; min-width: 280px; text-align: start; display: flex; flex-direction: column; gap: 16px; padding-top: 6px;">
            <p style="margin: 0; color: var(--blue); font-weight: 600; font-size: 1.2rem; line-height: 1;">Founder & Full-stack Developer</p>
            <p style="margin: 0; color: var(--muted); font-size: 1.05rem; line-height: 1.6;">
              Also a Product Management & Product Owner & Market Researcher...
            </p>
          </div>
        </article>

        <!-- Member 2 -->
        <article style="display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; padding: 40px; background: #f5f5f7; border-radius: 32px; gap: 40px;">
          <div style="display: flex; align-items: flex-start; gap: 32px; flex: 1; min-width: 280px;">
            <div style="width: 110px; height: 110px; border-radius: 50%; background: #e5e5ea; flex-shrink: 0; overflow: hidden; display: flex; align-items: center; justify-content: center;">
              <svg width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="#aeaeb2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            </div>
            <div style="display: flex; flex-direction: column; gap: 16px; padding-top: 6px;">
              <h3 style="margin: 0; font-size: 2rem; color: var(--ink); line-height: 1;">Antt</h3>
              <p style="margin: 0; color: var(--muted); font-size: 1.1rem; line-height: 1;">@antt</p>
              <div style="display: flex; gap: 12px; color: var(--muted); line-height: 1;">
                <a href="#" style="color: inherit; text-decoration: none;">X</a>
                <a href="#" style="color: inherit; text-decoration: none;">LinkedIn</a>
              </div>
            </div>
          </div>
          <div style="flex: 1.5; min-width: 280px; text-align: start; display: flex; flex-direction: column; gap: 16px; padding-top: 6px;">
            <p style="margin: 0; color: var(--blue); font-weight: 600; font-size: 1.2rem; line-height: 1;">Lead Developer</p>
            <p style="margin: 0; color: var(--muted); font-size: 1.05rem; line-height: 1.6;">
              Phụ trách phát triển và duy trì toàn bộ kiến trúc kỹ thuật nền tảng, mang lại trải nghiệm mượt mà nhất.
            </p>
          </div>
        </article>
        
        
      </div>
    </section>
  </main>
</Layout>
