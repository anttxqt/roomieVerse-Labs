---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Đội ngũ - Roomieverse Labs">
  <main>
    <section style="padding: 180px 20px 80px; max-width: 1200px; margin: 0 auto; text-align: center;">
      <h1 style="font-size: clamp(3rem, 6vw, 5rem); margin-bottom: 20px; color: var(--ink);">Đội ngũ của chúng tôi</h1>
      <p style="font-size: 1.2rem; color: var(--muted); max-width: 600px; margin: 0 auto;">
        Những con người đam mê công nghệ đằng sau hệ sinh thái Roomieverse Labs.
      </p>
    </section>

    <section style="padding: 0 20px 120px; max-width: 1200px; margin: 0 auto;">
      <div class="apple-grid" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px;">
        <!-- Member 1 -->
        <article class="apple-card reveal" style="display: flex; flex-direction: column; align-items: center; text-align: center; padding: 40px; background: #f5f5f7; border: none;">
          <div style="width: 160px; height: 160px; border-radius: 50%; background: #e5e5ea; margin-bottom: 24px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
            <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#aeaeb2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          </div>
          <h3 style="margin-bottom: 8px; font-size: 1.5rem; color: var(--ink);">[ Tên thành viên ]</h3>
          <p style="color: var(--blue); font-weight: 600; margin-bottom: 16px;">[ Vị trí / Chức vụ ]</p>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6;">[ Thông tin mô tả ngắn gọn về thành viên này. Nhấn mạnh vào chuyên môn và vai trò trong dự án. ]</p>
        </article>

        <!-- Member 2 -->
        <article class="apple-card reveal" style="transition-delay: 0.1s; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 40px; background: #f5f5f7; border: none;">
          <div style="width: 160px; height: 160px; border-radius: 50%; background: #e5e5ea; margin-bottom: 24px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
            <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#aeaeb2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          </div>
          <h3 style="margin-bottom: 8px; font-size: 1.5rem; color: var(--ink);">[ Tên thành viên ]</h3>
          <p style="color: var(--blue); font-weight: 600; margin-bottom: 16px;">[ Vị trí / Chức vụ ]</p>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6;">[ Thông tin mô tả ngắn gọn về thành viên này. Nhấn mạnh vào chuyên môn và vai trò trong dự án. ]</p>
        </article>
        
        <!-- Member 3 -->
        <article class="apple-card reveal" style="transition-delay: 0.2s; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 40px; background: #f5f5f7; border: none;">
          <div style="width: 160px; height: 160px; border-radius: 50%; background: #e5e5ea; margin-bottom: 24px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
            <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#aeaeb2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          </div>
          <h3 style="margin-bottom: 8px; font-size: 1.5rem; color: var(--ink);">[ Tên thành viên ]</h3>
          <p style="color: var(--blue); font-weight: 600; margin-bottom: 16px;">[ Vị trí / Chức vụ ]</p>
          <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.6;">[ Thông tin mô tả ngắn gọn về thành viên này. Nhấn mạnh vào chuyên môn và vai trò trong dự án. ]</p>
        </article>
      </div>
    </section>
  </main>
</Layout>
