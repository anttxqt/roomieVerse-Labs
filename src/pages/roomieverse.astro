---
import Layout from '../layouts/Layout.astro'
import RoomieverseLabsLogo from '../components/RoomieverseLabsLogo.astro'
---

<Layout title="roomieverse & roomibase · Giải pháp tìm chỗ ở" theme="dark" scrollTheme="light">
  <main>
    <section class="apple-bento-section" style="padding-top: 180px; padding-bottom: 80px; min-height: 100vh;">
      
      <div class="keynote-grid" style="grid-template-columns: repeat(10, 1fr);">
        <!-- Forced Centerpiece -->
        <article class="apple-card apple-card--centerpiece" style="display: flex; align-items: center; justify-content: center; grid-column: 4 / span 4; grid-row: 3 / span 4; z-index: 2;">
          <img src="/brand/roomieverse-cropped.png" alt="roomieverse logo" style="max-width: 70%; max-height: 70%; object-fit: contain;" />
        </article>

        <!-- 1. COMMUNITY (R1-R2, C1-C4) -->
        <article class="apple-card" style="grid-column: span 4; grid-row: span 2; display: flex; align-items: center; justify-content: center; text-align: center;">
          <h3 class="apple-gradient-text--pink" style="margin: 0;">CỘNG ĐỒNG.</h3>
        </article>

        <!-- 2. Lifestyles (R1-R2, C5-C10) -->
        <article class="apple-card" style="grid-column: span 6; grid-row: span 2; transition-delay: 0.1s; display: flex; align-items: center; justify-content: center; text-align: center;">
          <h3 style="margin: 0;">Lối sống tương đồng</h3>
        </article>

        <!-- 3. Direct (R3-R4, C1-C3) -->
        <article class="apple-card" style="grid-column: span 3; grid-row: span 2; transition-delay: 0.15s; display: flex; align-items: center; justify-content: center; text-align: center;">
          <h3 style="margin: 0;">Trực tiếp</h3>
        </article>

        <!-- 4. Badge (R3, C8-C10) -->
        <article class="apple-card" style="grid-column: span 3; grid-row: span 1; transition-delay: 0.2s; display: flex; align-items: center; justify-content: center; text-align: center;">
          <span style="color: #fff; font-weight: bold; opacity: 0.2; font-size: 1rem; text-align: center;">[ Badge ]</span>
        </article>

        <!-- 5. Transparency (R4-R6, C8-C10) -->
        <article class="apple-card" style="grid-column: span 3; grid-row: span 3; transition-delay: 0.25s; display: flex; align-items: center; justify-content: center; text-align: center;">
          <h3 style="margin: 0; font-size: 1.5rem;">Minh bạch</h3>
        </article>

        <!-- 6. Feature (R5-R6, C1-C3) -->
        <article class="apple-card" style="grid-column: span 3; grid-row: span 2; transition-delay: 0.3s; display: flex; align-items: center; justify-content: center; text-align: center;">
          <span style="color: #fff; font-weight: bold; opacity: 0.2; font-size: 1rem; text-align: center;">[ Feature ]</span>
        </article>

        <!-- 7. Illustration (R7-R8, C1-C6) -->
        <article class="apple-card" style="grid-column: span 6; grid-row: span 2; transition-delay: 0.35s; display: flex; align-items: center; justify-content: center; text-align: center;">
          <span style="color: #fff; font-weight: bold; opacity: 0.2; font-size: 1.5rem;">[ Roommate matching illustration ]</span>
        </article>

        <!-- 8. Community (R7-R8, C7-C10) -->
        <article class="apple-card" style="grid-column: span 4; grid-row: span 2; transition-delay: 0.4s; display: flex; align-items: center; justify-content: center; text-align: center;">
          <span style="color: #fff; font-weight: bold; opacity: 0.2; font-size: 1.2rem; text-align: center;">[ Community ]</span>
        </article>
      </div>

      <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
          const grids = document.querySelectorAll('.keynote-grid');
          
          let gridDataList = [];
  
          function measureGrids() {
            gridDataList = Array.from(grids).map(grid => {
              const centerpiece = grid.querySelector('.apple-card--centerpiece');
              if (!centerpiece) return null;
              
              const cards = Array.from(grid.querySelectorAll('.apple-card:not(.apple-card--centerpiece)'));
              
              const centerRect = centerpiece.getBoundingClientRect();
              const targetX = centerRect.left + centerRect.width / 2;
              const targetY = centerRect.top + centerRect.height / 2;
              
              const cardData = cards.map(card => {
                card.style.transform = '';
                const rect = card.getBoundingClientRect();
                const cardX = rect.left + rect.width / 2;
                const cardY = rect.top + rect.height / 2;
                return {
                  el: card,
                  dx: targetX - cardX,
                  dy: targetY - cardY
                };
              });
              
              return { grid, cardData, entranceStarted: 0 };
            }).filter(Boolean);
            
            updateGather();
          }
  
          function updateGather() {
            if (gridDataList.length === 0) return;
            
            let anyAnimating = false;

            gridDataList.forEach(gridObj => {
              const { grid, cardData } = gridObj;
              const gridRect = grid.getBoundingClientRect();
              
              if (gridObj.entranceStarted === 0) {
                if (document.body.classList.contains('is-loaded')) {
                  // Start animation when grid enters the bottom 85% of viewport
                  if (gridRect.top < window.innerHeight * 0.85) {
                    gridObj.entranceStarted = Date.now() + 150;
                  }
                }
              }
              
              let loadProgress = -1;
              let timeElapsed = 0;
              
              if (gridObj.entranceStarted > 0) {
                timeElapsed = Date.now() - gridObj.entranceStarted;
                if (timeElapsed > 0) {
                  let t = Math.min(timeElapsed / 1000, 1);
                  let loadEase = 1 - Math.pow(1 - t, 3);
                  loadProgress = -1 + loadEase;
                }
              }

              if (gridObj.entranceStarted === 0 || timeElapsed < 1000) {
                anyAnimating = true;
              }

              let scrollProgress = 0;
              if (gridRect.top < -320) {
                scrollProgress = (-320 - gridRect.top) / 300;
              }
              
              let progress = loadProgress < 0 ? loadProgress : scrollProgress;
              progress = Math.max(-1.5, Math.min(progress, 1.2));
    
              cardData.forEach(data => {
                if (progress <= 0) {
                  data.el.style.transition = 'none';
                } else {
                  data.el.style.transition = '';
                }
                
                let p = progress;
                let easeP = p > 0 ? p * (2 - p) : p;
                
                let scale = 1;
                if (p > 0) scale = 1 - (easeP * 0.4);
                else scale = 1 - (p * 0.1);
                
                let opacity = 1;
                if (p > 0) opacity = 1 - (easeP * 0.5);
                else opacity = 1 + p;
                
                data.el.style.transform = `translate(${data.dx * easeP}px, ${data.dy * easeP}px) scale(${scale})`;
                data.el.style.opacity = Math.max(0, opacity);
              });
            });
            
            if (anyAnimating) {
              requestAnimationFrame(updateGather);
            }
          }
  
          window.addEventListener('resize', measureGrids);
          window.addEventListener('scroll', () => {
            requestAnimationFrame(updateGather);
          }, { passive: true });
  
          setTimeout(measureGrids, 100);
        });
      </script>

      <!-- roomibase section -->
      <div class="keynote-grid keynote-grid--roomibase" style="grid-template-columns: repeat(10, 1fr); margin-top: 150px;">
        <!-- Forced Centerpiece (Wide for roomibase) -->
        <article class="apple-card apple-card--centerpiece" style="display: flex; align-items: center; justify-content: center; grid-column: 3 / span 6; grid-row: 3 / span 2; z-index: 2;">
          <img src="/brand/roomibase-rounded.png" alt="roomibase logo" style="max-width: 80%; max-height: 80%; object-fit: contain;" />
        </article>

        <!-- 1. TRỰC TIẾP -->
        <article class="apple-card" style="grid-column: span 5; grid-row: span 2; display: flex; align-items: center; justify-content: center; text-align: center;">
          <h3 class="apple-gradient-text--navy" style="margin: 0;">TRỰC TIẾP.</h3>
        </article>

        <!-- 2. Tìm phòng, nhà cho thuê -->
        <article class="apple-card" style="grid-column: span 5; grid-row: span 2; transition-delay: 0.1s; display: flex; align-items: center; justify-content: center; text-align: center;">
          <h3 style="margin: 0;">Tìm phòng, nhà cho thuê</h3>
        </article>

        <!-- 3. Căn hộ -->
        <article class="apple-card" style="grid-column: span 2; grid-row: span 2; transition-delay: 0.15s; display: flex; align-items: center; justify-content: center; text-align: center;">
          <h3 style="margin: 0;">Căn hộ</h3>
        </article>

        <!-- 4. Đang phát triển -->
        <article class="apple-card" style="grid-column: span 2; grid-row: span 2; transition-delay: 0.2s; display: flex; align-items: center; justify-content: center; text-align: center;">
          <span class="badge badge--coming-soon" style="margin: 0;">Đang phát triển</span>
        </article>

        <!-- 5. An toàn -->
        <article class="apple-card" style="grid-column: span 4; grid-row: span 2; transition-delay: 0.25s; display: flex; align-items: center; justify-content: center; text-align: center;">
          <h3 style="margin: 0; font-size: 1.5rem;">An toàn & Minh bạch</h3>
        </article>

        <!-- 6. Illustration -->
        <article class="apple-card" style="grid-column: span 6; grid-row: span 2; transition-delay: 0.3s; display: flex; align-items: center; justify-content: center; text-align: center;">
          <span style="color: #fff; font-weight: bold; opacity: 0.2; font-size: 1.5rem;">[ Làm việc trực tiếp với chủ nhà ]</span>
        </article>
      </div>

      <!-- Divider -->
      <hr style="margin: 120px auto; max-width: 200px; border: 0; border-top: 2px dashed rgba(255,255,255,0.2);" />

      <!-- comparison section -->
      <div class="section-title reveal" id="comparison" style="text-align: center; margin-bottom: 60px;">
        <h2 style="font-size: clamp(2rem, 4vw, 3rem); color: #fff;">Lựa chọn nào dành cho bạn?</h2>
      </div>

      <div class="apple-grid" style="position: relative; margin-bottom: 120px;">
        <!-- roomibase column -->
        <article class="apple-card--span-3 reveal" style="display: flex; flex-direction: column; align-items: center; text-align: center; justify-content: center; min-height: 300px; padding: 40px;">
          <img src="/brand/roomibase-rounded.png" alt="roomibase" style="height: 72px; object-fit: contain; margin-bottom: 32px;" />
          <p style="font-size: clamp(1.1rem, 2vw, 1.3rem); color: rgba(255,255,255,0.5); max-width: 80%; line-height: 1.6;">[ Content for roomibase ]</p>
        </article>

        <!-- Divider -->
        <div class="reveal desktop-only-divider" style="position: absolute; left: 50%; top: 10%; bottom: 10%; width: 1px; background: rgba(255,255,255,0.15); transform: translateX(-50%);"></div>

        <!-- roomieverse column -->
        <article class="apple-card--span-3 reveal" style="display: flex; flex-direction: column; align-items: center; text-align: center; justify-content: center; min-height: 300px; transition-delay: 0.1s; padding: 40px;">
          <img src="/brand/roomieverse-stacked-cropped.png" alt="roomieverse" style="height: 72px; object-fit: contain; margin-bottom: 32px; transform: scale(1.4);" />
          <p style="font-size: clamp(1.1rem, 2vw, 1.3rem); color: rgba(255,255,255,0.5); max-width: 80%; line-height: 1.6;">[ Content for roomieverse ]</p>
        </article>
      </div>

    </section>
  </main>
</Layout>
