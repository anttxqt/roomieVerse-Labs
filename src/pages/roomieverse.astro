---
import Layout from '../layouts/Layout.astro'
import RoomieverseLabsLogo from '../components/RoomieverseLabsLogo.astro'
---

<Layout title="roomieverse & roomibase · Giải pháp tìm chỗ ở">
  <main>
    <section class="apple-bento-section" style="padding-top: 150px; min-height: 100vh;">
      
      <div class="keynote-grid">
        <!-- Forced Centerpiece -->
        <article class="apple-card reveal" style="display: flex; align-items: center; justify-content: center; grid-column: 4 / span 3; grid-row: 3 / span 4; z-index: 2;">
          <img src="/brand/roomieverse-cropped.png" alt="roomieverse logo" style="max-width: 80%; max-height: 80%; object-fit: contain;" />
        </article>

        <!-- 1. COMMUNITY (R1-R3, C1-C3) -->
        <article class="apple-card keynote-card--col-3 keynote-card--row-3 reveal" style="display: flex; align-items: center; justify-content: center; text-align: center;">
          <h3 class="apple-gradient-text--pink" style="margin: 0;">CỘNG ĐỒNG.</h3>
        </article>

        <!-- 2. Lifestyles (R1, C4-C8) -->
        <article class="apple-card keynote-card--col-5 keynote-card--row-1 reveal" style="transition-delay: 0.1s; display: flex; align-items: center; justify-content: center; text-align: center;">
          <h3 style="margin: 0;">Lối sống tương đồng</h3>
        </article>

        <!-- 3. Verification Badge (R2, C4-C6) -->
        <article class="apple-card keynote-card--col-3 keynote-card--row-1 reveal" style="transition-delay: 0.15s; display: flex; align-items: center; justify-content: center; text-align: center;">
          <span style="color: #fff; font-weight: bold; opacity: 0.2; font-size: 1rem; text-align: center;">[ Badge ]</span>
        </article>

        <!-- 4. Transparency (R2-R4, C7-C8) -->
        <article class="apple-card keynote-card--col-2 keynote-card--row-3 reveal" style="transition-delay: 0.2s; display: flex; align-items: center; justify-content: center; text-align: center;">
          <h3 style="margin: 0; font-size: 1.5rem;">Minh bạch</h3>
        </article>

        <!-- 5. Direct (R4-R6, C1-C3) -->
        <article class="apple-card keynote-card--col-3 keynote-card--row-3 reveal" style="transition-delay: 0.25s; display: flex; align-items: center; justify-content: center; text-align: center;">
          <h3 style="margin: 0;">Trực tiếp</h3>
        </article>

        <!-- 6. Illustration (R5-R6, C7-C8) -->
        <article class="apple-card keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.3s; display: flex; align-items: center; justify-content: center; text-align: center;">
          <span style="color: #fff; font-weight: bold; opacity: 0.2; font-size: 1rem; text-align: center;">[ Illustration ]</span>
        </article>
      </div>

      <!-- Divider -->
      <hr style="margin: 120px auto; max-width: 200px; border: 0; border-top: 2px dashed rgba(255,255,255,0.2);" />

      <!-- roomibase section -->
      <div class="section-title reveal" id="roomibase" style="text-align: center; margin-bottom: 60px;">
        <h2 style="font-size: clamp(3rem, 6vw, 5rem); color: #fff;">roomi<span style="color: var(--roomibase);">base</span></h2>
        <p style="margin-top: 24px; font-size: 1.25rem; color: #a1a1a6; max-width: 600px; margin-inline: auto;">
          Tìm phòng, tìm nhà cho thuê
        </p>
      </div>

      <div class="apple-grid">
        <!-- Main Feature (Large) -->
        <article class="apple-card apple-card--span-6 apple-card--row-2 reveal">
          <h3 class="apple-gradient-text--navy">TRỰC TIẾP.</h3>
          <p>Dành cho người muốn tìm trọ hoặc tìm nhà, căn hộ cho thuê nguyên căn. Có thể qua trung gian môi giới hoặc làm việc trực tiếp với chủ nhà.</p>
          <span class="badge badge--coming-soon" style="margin-top: 16px; align-self: flex-start;">Đang phát triển</span>
          <div class="apple-visual">
            <span style="color: #fff; font-weight: bold; opacity: 0.2; font-size: 1.5rem;">[ Ảnh nền chờ ra mắt roomibase ]</span>
            <div class="apple-visual-edge"></div>
          </div>
        </article>
      </div>

      <!-- Divider -->
      <hr style="margin: 120px auto; max-width: 200px; border: 0; border-top: 2px dashed rgba(255,255,255,0.2);" />

      <!-- comparison section -->
      <div class="section-title reveal" id="comparison" style="text-align: center; margin-bottom: 60px;">
        <h2 style="font-size: clamp(2rem, 4vw, 3rem); color: #fff;">Lựa chọn nào dành cho bạn?</h2>
      </div>

      <div class="apple-grid">
        <!-- roomibase column -->
        <article class="apple-card apple-card--span-3 reveal" style="align-items: center; text-align: center; justify-content: center; min-height: 300px;">
          <img src="/brand/roomibase-rounded.png" alt="roomibase" style="height: 48px; object-fit: contain; margin-bottom: 24px;" />
          <p style="color: rgba(255,255,255,0.5);">[ Content for roomibase ]</p>
        </article>

        <!-- roomieverse column -->
        <article class="apple-card apple-card--span-3 reveal" style="align-items: center; text-align: center; justify-content: center; min-height: 300px; transition-delay: 0.1s;">
          <img src="/brand/roomieverse-stacked-cropped.png" alt="roomieverse" style="height: 48px; object-fit: contain; margin-bottom: 24px; transform: scale(1.6);" />
          <p style="color: rgba(255,255,255,0.5);">[ Content for roomieverse ]</p>
        </article>
      </div>

    </section>
  </main>
</Layout>
