---
import Layout from '../layouts/Layout.astro'
import RoomieverseLabsLogo from '../components/RoomieverseLabsLogo.astro'
---

<Layout title="roomieverse & roomibase · Giải pháp tìm chỗ ở" theme="dark">
  <main>
    <section class="apple-bento-section" style="padding-top: 180px; padding-bottom: 80px; min-height: 100vh;">
      
      <div class="keynote-grid">
        <!-- Forced Centerpiece -->
        <article class="apple-card apple-card--centerpiece" style="display: flex; align-items: center; justify-content: center; grid-column: 3 / span 4; grid-row: 3 / span 3; z-index: 2;">
          <img src="/brand/roomieverse-cropped.png" alt="roomieverse logo" style="max-width: 65%; max-height: 65%; object-fit: contain;" />
        </article>

        <!-- 1. COMMUNITY (R1-R2, C1-C3) -->
        <article class="apple-card keynote-card--col-3 keynote-card--row-2" style="display: flex; align-items: center; justify-content: center; text-align: center;">
          <h3 class="apple-gradient-text--pink" style="margin: 0;">CỘNG ĐỒNG.</h3>
        </article>

        <!-- 2. Lifestyles (R1-R2, C4-C8) -->
        <article class="apple-card keynote-card--col-5 keynote-card--row-2" style="transition-delay: 0.1s; display: flex; align-items: center; justify-content: center; text-align: center;">
          <h3 style="margin: 0;">Lối sống tương đồng</h3>
        </article>

        <!-- 3. Direct (R3-R4, C1-C2) -->
        <article class="apple-card keynote-card--col-2 keynote-card--row-2" style="transition-delay: 0.15s; display: flex; align-items: center; justify-content: center; text-align: center;">
          <h3 style="margin: 0;">Trực tiếp</h3>
        </article>

        <!-- 4. Badge (R3, C7-C8) -->
        <article class="apple-card keynote-card--col-2 keynote-card--row-1" style="transition-delay: 0.2s; display: flex; align-items: center; justify-content: center; text-align: center;">
          <span style="color: #fff; font-weight: bold; opacity: 0.2; font-size: 1rem; text-align: center;">[ Badge ]</span>
        </article>

        <!-- 5. Transparency (R4-R5, C7-C8) -->
        <article class="apple-card keynote-card--col-2 keynote-card--row-2" style="transition-delay: 0.25s; display: flex; align-items: center; justify-content: center; text-align: center;">
          <h3 style="margin: 0; font-size: 1.5rem;">Minh bạch</h3>
        </article>

        <!-- 6. Feature (R5, C1-C2) -->
        <article class="apple-card keynote-card--col-2 keynote-card--row-1" style="transition-delay: 0.3s; display: flex; align-items: center; justify-content: center; text-align: center;">
          <span style="color: #fff; font-weight: bold; opacity: 0.2; font-size: 1rem; text-align: center;">[ Feature ]</span>
        </article>

        <!-- 7. Illustration (R6-R8, C1-C5) -->
        <article class="apple-card keynote-card--col-5 keynote-card--row-3" style="transition-delay: 0.35s; display: flex; align-items: center; justify-content: center; text-align: center;">
          <span style="color: #fff; font-weight: bold; opacity: 0.2; font-size: 1.5rem;">[ Roommate matching illustration ]</span>
        </article>

        <!-- 8. Community (R6-R8, C6-C8) -->
        <article class="apple-card keynote-card--col-3 keynote-card--row-3" style="transition-delay: 0.4s; display: flex; align-items: center; justify-content: center; text-align: center;">
          <span style="color: #fff; font-weight: bold; opacity: 0.2; font-size: 1.2rem; text-align: center;">[ Community ]</span>
        </article>
      </div>

      <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
          const grid = document.querySelector('.keynote-grid');
          const centerpiece = grid.querySelector('.apple-card--centerpiece');
          const cards = Array.from(grid.querySelectorAll('.apple-card:not(.apple-card--centerpiece)'));
          
          let cardData = [];
  
          function measureGrid() {
            if (!grid || !centerpiece) return;
            const gridRect = grid.getBoundingClientRect();
            const centerRect = centerpiece.getBoundingClientRect();
            const targetX = centerRect.left + centerRect.width / 2;
            const targetY = centerRect.top + centerRect.height / 2;
  
            cardData = cards.map(card => {
              card.style.transform = '';
              const rect = card.getBoundingClientRect();
              const cardX = rect.left + rect.width / 2;
              const cardY = rect.top + rect.height / 2;
              return {
                el: card,
                dx: targetX - cardX,
                dy: targetY - cardY
              };
            });
            
            updateGather();
          }
  
          let entranceStarted = 0;

          function updateGather() {
            if (!grid) return;
            
            if (entranceStarted === 0) {
              if (document.body.classList.contains('is-loaded')) {
                entranceStarted = Date.now();
              }
            }
            
            let loadProgress = -1;
            if (entranceStarted > 0) {
              let timeElapsed = Date.now() - entranceStarted;
              let t = Math.min(timeElapsed / 1000, 1);
              let loadEase = 1 - Math.pow(1 - t, 3); // Cubic ease-out
              loadProgress = -1 + loadEase;
            }

            const scrollY = window.scrollY;
            let scrollProgress = 0;
            if (scrollY > 150) {
              // 150 -> 400 maps to 0 -> 1 (gather into logo)
              scrollProgress = (scrollY - 150) / 250;
            }
            
            let progress = loadProgress < 0 ? loadProgress : scrollProgress;
            progress = Math.max(-1.5, Math.min(progress, 1.2));
  
            cardData.forEach(data => {
              let p = progress;
              let easeP = p > 0 ? p * (2 - p) : p; // ease-out when collapsing
              
              let scale = 1;
              if (p > 0) scale = 1 - (easeP * 0.4); // shrink when collapsing
              else scale = 1 - (p * 0.1); // slightly grow when pushed out
              
              let opacity = 1;
              if (p > 0) opacity = 1 - (easeP * 0.5);
              else opacity = 1 + p; // fade out when pushed out
              
              data.el.style.transform = `translate(${data.dx * easeP}px, ${data.dy * easeP}px) scale(${scale})`;
              data.el.style.opacity = Math.max(0, opacity);
            });
            
            if (entranceStarted > 0 && Date.now() - entranceStarted < 1000) {
              requestAnimationFrame(updateGather);
            }
          }
  
          window.addEventListener('resize', measureGrid);
          window.addEventListener('scroll', () => {
            requestAnimationFrame(updateGather);
          }, { passive: true });
  
          setTimeout(measureGrid, 100);
        });
      </script>

      <!-- Divider -->
      <hr style="margin: 120px auto; max-width: 200px; border: 0; border-top: 2px dashed rgba(255,255,255,0.2);" />

      <!-- roomibase section -->
      <div class="section-title reveal" id="roomibase" style="text-align: center; margin-bottom: 60px;">
        <h2 style="font-size: clamp(3rem, 6vw, 5rem); color: #fff;">roomi<span style="color: var(--roomibase);">base</span></h2>
        <p style="margin-top: 24px; font-size: 1.25rem; color: #a1a1a6; max-width: 600px; margin-inline: auto;">
          Tìm phòng, tìm nhà cho thuê
        </p>
      </div>

      <div class="apple-grid">
        <!-- Main Feature (Large) -->
        <article class="apple-card apple-card--span-6 apple-card--row-2 reveal">
          <h3 class="apple-gradient-text--navy">TRỰC TIẾP.</h3>
          <p>Dành cho người muốn tìm trọ hoặc tìm nhà, căn hộ cho thuê nguyên căn. Có thể qua trung gian môi giới hoặc làm việc trực tiếp với chủ nhà.</p>
          <span class="badge badge--coming-soon" style="margin-top: 16px; align-self: flex-start;">Đang phát triển</span>
          <div class="apple-visual">
            <span style="color: #fff; font-weight: bold; opacity: 0.2; font-size: 1.5rem;">[ Ảnh nền chờ ra mắt roomibase ]</span>
            <div class="apple-visual-edge"></div>
          </div>
        </article>
      </div>

      <!-- Divider -->
      <hr style="margin: 120px auto; max-width: 200px; border: 0; border-top: 2px dashed rgba(255,255,255,0.2);" />

      <!-- comparison section -->
      <div class="section-title reveal" id="comparison" style="text-align: center; margin-bottom: 60px;">
        <h2 style="font-size: clamp(2rem, 4vw, 3rem); color: #fff;">Lựa chọn nào dành cho bạn?</h2>
      </div>

      <div class="apple-grid">
        <!-- roomibase column -->
        <article class="apple-card apple-card--span-3 reveal" style="align-items: center; text-align: center; justify-content: center; min-height: 300px;">
          <img src="/brand/roomibase-rounded.png" alt="roomibase" style="height: 48px; object-fit: contain; margin-bottom: 24px;" />
          <p style="color: rgba(255,255,255,0.5);">[ Content for roomibase ]</p>
        </article>

        <!-- roomieverse column -->
        <article class="apple-card apple-card--span-3 reveal" style="align-items: center; text-align: center; justify-content: center; min-height: 300px; transition-delay: 0.1s;">
          <img src="/brand/roomieverse-stacked-cropped.png" alt="roomieverse" style="height: 48px; object-fit: contain; margin-bottom: 24px; transform: scale(1.6);" />
          <p style="color: rgba(255,255,255,0.5);">[ Content for roomieverse ]</p>
        </article>
      </div>

    </section>
  </main>
</Layout>
