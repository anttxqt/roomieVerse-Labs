---
import Layout from '../layouts/Layout.astro'
import RoomieverseLabsLogo from '../components/RoomieverseLabsLogo.astro'
---

<Layout title="roomio · Vận hành & quản lý phòng cho thuê">
  <main>
    <div class="carousel-container" id="roomio-carousel" style="padding-top: 180px; padding-bottom: 80px; min-height: 100vh;">
      <div class="carousel-track">
        <!-- Page 1 -->
        <div class="carousel-slide">
          <div class="keynote-grid">
            <!-- Forced Centerpiece -->
            <article class="keynote-card keynote-card--centerpiece reveal" style="display: flex; align-items: center; justify-content: center;">
              <img src="/brand/roomio.png" alt="roomio logo" style="max-width: 70%; max-height: 70%; object-fit: contain;" />
            </article>

            <!-- 1. Big Text (R1-R2, C1-C2) -->
            <article class="keynote-card keynote-card--text-hero keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.1s;">
              <h3 class="keynote-gradient-text">TỰ ĐỘNG<br/>HOÀN TOÀN</h3>
              <p style="margin-top: 12px;">Tính bill & gửi thông báo nhắc nợ không trễ hẹn.</p>
            </article>

            <!-- 2. Chip (R1-R2, C3-C4) -->
            <article class="keynote-card keynote-card--chip keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.15s; flex-direction: column; justify-content: center;">
              <div class="keynote-chip-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
              </div>
              <h3>Hợp đồng số</h3>
            </article>

            <!-- 3. Chip (R1-R2, C5-C6) -->
            <article class="keynote-card keynote-card--chip keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.2s; flex-direction: column; justify-content: center;">
              <div class="keynote-chip-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
              </div>
              <h3>Phân quyền</h3>
            </article>

            <!-- 4. Tall Card (R1-R4, C7-C8) -->
            <article class="keynote-card keynote-card--col-2 keynote-card--row-4 reveal" style="transition-delay: 0.25s; justify-content: flex-end;">
              <span style="color: #1d1d1f; font-weight: bold; opacity: 0.4; font-size: 1.2rem; text-align: center; margin-bottom: 20px;">[ Báo cáo ]</span>
            </article>

            <!-- 5. Chip (R3-R4, C1-C2) -->
            <article class="keynote-card keynote-card--chip keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.3s; flex-direction: column; justify-content: center;">
              <div class="keynote-chip-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
              </div>
              <h3>Bảo trì sự cố</h3>
            </article>

            <!-- 6. Wide Image Card (R5-R6, C1-C6) -->
            <article class="keynote-card keynote-card--col-6 keynote-card--row-2 reveal" style="transition-delay: 0.45s; align-items: center; justify-content: center;">
              <span style="color: #1d1d1f; font-weight: bold; opacity: 0.3; font-size: 1.5rem;">[ Ảnh minh họa Dashboard hoặc Mobile App ]</span>
            </article>

            <!-- 7. Medium Card (R5-R6, C7-C8) -->
            <article class="keynote-card keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.5s; justify-content: flex-end;">
              <span style="color: #1d1d1f; font-weight: bold; opacity: 0.4; font-size: 1.2rem; text-align: center; margin-bottom: 20px;">[ Thống kê ]</span>
            </article>
          </div>
        </div>

        <!-- Page 2 -->
        <div class="carousel-slide">
          <div class="keynote-grid">
            <!-- Forced Centerpiece -->
            <article class="keynote-card keynote-card--centerpiece" style="display: flex; align-items: center; justify-content: center;">
              <img src="/brand/roomio.png" alt="roomio logo" style="max-width: 70%; max-height: 70%; object-fit: contain;" />
            </article>

            <!-- 1. Big Text (R1-R2, C1-C2) -->
            <article class="keynote-card keynote-card--text-hero keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.1s;">
              <h3 class="keynote-gradient-text" style="font-size: 2rem;">TÍNH NĂNG<br/>MỚI</h3>
              <p style="margin-top: 12px;">Đang được cập nhật liên tục.</p>
            </article>

            <!-- 2. Chip (R1-R2, C3-C4) -->
            <article class="keynote-card keynote-card--chip keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.15s; flex-direction: column; justify-content: center;">
              <div class="keynote-chip-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              </div>
              <h3>[ Tính năng 1 ]</h3>
            </article>

            <!-- 3. Chip (R1-R2, C5-C6) -->
            <article class="keynote-card keynote-card--chip keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.2s; flex-direction: column; justify-content: center;">
              <div class="keynote-chip-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
              </div>
              <h3>[ Tính năng 2 ]</h3>
            </article>

            <!-- 4. Tall Card (R1-R4, C7-C8) -->
            <article class="keynote-card keynote-card--col-2 keynote-card--row-4 reveal" style="transition-delay: 0.25s; justify-content: flex-end;">
              <span style="color: #1d1d1f; font-weight: bold; opacity: 0.4; font-size: 1.2rem; text-align: center; margin-bottom: 20px;">[ Tính năng 3 ]</span>
            </article>

            <!-- 5. Chip (R3-R4, C1-C2) -->
            <article class="keynote-card keynote-card--chip keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.3s; flex-direction: column; justify-content: center;">
              <div class="keynote-chip-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              </div>
              <h3>[ Tính năng 4 ]</h3>
            </article>

            <!-- 6. Wide Image Card (R5-R6, C1-C6) -->
            <article class="keynote-card keynote-card--col-6 keynote-card--row-2 reveal" style="transition-delay: 0.45s; align-items: center; justify-content: center;">
              <span style="color: #1d1d1f; font-weight: bold; opacity: 0.3; font-size: 1.5rem;">[ Ảnh minh họa tính năng ]</span>
            </article>

            <!-- 7. Medium Card (R5-R6, C7-C8) -->
            <article class="keynote-card keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.5s; justify-content: flex-end;">
              <span style="color: #1d1d1f; font-weight: bold; opacity: 0.4; font-size: 1.2rem; text-align: center; margin-bottom: 20px;">[ Tính năng 5 ]</span>
            </article>
          </div>
        </div>

        <!-- Page 3 -->
        <div class="carousel-slide" style="align-items: center; justify-content: center; padding: 2rem;">
          <h2 style="color: #0071e3; font-size: clamp(2rem, 5vw, 4rem); max-width: 900px; line-height: 1.2; margin-bottom: 40px; text-align: center;">
            Trải nghiệm việc quản lý phòng cho thuê dễ dàng nhất có thể
          </h2>
          <img src="/brand/roomio.png" alt="roomio logo" style="max-height: 100px; margin-bottom: 40px; object-fit: contain;" />
          <a href="https://roomio.vn" target="_blank" class="cta-btn" style="--hover-bg: #0071e3; border: 1px solid #0071e3; color: #0071e3;" onmouseenter="const r=this.getBoundingClientRect(); this.style.setProperty('--x', event.clientX - r.left + 'px'); this.style.setProperty('--y', event.clientY - r.top + 'px');">
            Thử ngay
          </a>
        </div>
      </div>
      
      <div class="carousel-dots">
        <button class="carousel-dot active" aria-label="Page 1"></button>
        <button class="carousel-dot" aria-label="Page 2"></button>
        <button class="carousel-dot" aria-label="Page 3"></button>
      </div>
      
      <button class="carousel-arrow carousel-arrow--prev" aria-label="Previous" style="display: none;">&#10094;</button>
      <button class="carousel-arrow carousel-arrow--next" aria-label="Next">&#10095;</button>
    </div>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const carousels = document.querySelectorAll('.carousel-container');
        carousels.forEach(carousel => {
          const track = carousel.querySelector('.carousel-track');
          const dots = carousel.querySelectorAll('.carousel-dot');
          const prevBtn = carousel.querySelector('.carousel-arrow--prev');
          const nextBtn = carousel.querySelector('.carousel-arrow--next');
          let currentIndex = 0;
          
          const updateCarousel = (index) => {
            currentIndex = index;
            track.style.transform = `translateX(-${index * 50}%)`;
            dots.forEach(d => d.classList.remove('active'));
            if (dots[index]) dots[index].classList.add('active');
            
            if (prevBtn && nextBtn) {
              prevBtn.style.display = index === 0 ? 'none' : 'flex';
              nextBtn.style.display = index === dots.length - 1 ? 'none' : 'flex';
            }
          };

          dots.forEach((dot, index) => {
            dot.addEventListener('click', () => updateCarousel(index));
          });
          
          if (prevBtn) prevBtn.addEventListener('click', () => updateCarousel(Math.max(0, currentIndex - 1)));
          if (nextBtn) nextBtn.addEventListener('click', () => updateCarousel(Math.min(dots.length - 1, currentIndex + 1)));
        });
        
        const grids = document.querySelectorAll('.keynote-grid');
        
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const cards = entry.target.querySelectorAll('.keynote-card');
              cards.forEach((card, index) => {
                setTimeout(() => {
                  card.classList.add('reveal-active');
                  card.style.opacity = '1';
                  card.style.transform = 'translateY(0) scale(1)';
                }, index * 50);
              });
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1 });

        grids.forEach(grid => observer.observe(grid));
      });
    </script>
  </main>
</Layout>
