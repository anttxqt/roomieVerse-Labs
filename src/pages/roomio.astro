---
import Layout from '../layouts/Layout.astro'
import RoomieverseLabsLogo from '../components/RoomieverseLabsLogo.astro'
---

<Layout title="roomio · Vận hành & quản lý phòng cho thuê">
  <main>
    <section class="menu-section" style="padding-top: 150px; min-height: 80vh;">
      <div class="section-title reveal" id="hero">
        <h2>roomio</h2>
        <p style="margin-top: 20px; font-size: 1.2rem; color: var(--muted); max-width: 600px; margin-inline: auto;">
          Vận hành & quản lý phòng cho thuê
        </p>
      </div>

      <div class="dish-list" style="margin-top: 80px;">
        <article class="dish-card product-card product-card--blue reveal" style="grid-template-columns: 1fr;">
          <div class="dish-copy" style="text-align: center; max-width: 800px; margin: 0 auto;">
            <p>
              Dành cho chủ trọ quản lý tòa nhà, phòng, khách thuê, hợp đồng, hóa đơn, thu tiền, sự cố và nhân viên ở cùng một nơi. Gửi thông báo nhắc nợ hàng tháng, gửi bill tự động.
            </p>
          </div>
          <div class="product-visual" style="margin-top: 40px; border-radius: 20px; box-shadow: 0 20px 40px var(--line);">
            <div style="background: var(--paper-blue); width: 100%; aspect-ratio: 16/9; display: flex; align-items: center; justify-content: center; border-radius: inherit;">
              <span style="color: var(--blue); font-weight: bold; font-size: 1.5rem;">[ Ảnh giao diện phần mềm roomio ]</span>
            </div>
          </div>
        </article>
      </div>
    </section>
  </main>
</Layout>
