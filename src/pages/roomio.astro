---
import Layout from '../layouts/Layout.astro'
import RoomieverseLabsLogo from '../components/RoomieverseLabsLogo.astro'
---

<Layout title="roomio · Vận hành & quản lý phòng cho thuê">
  <main>
    <section class="apple-bento-section">
      <div class="section-title reveal" style="text-align: center; margin-bottom: 60px;">
        <h2 style="font-size: clamp(3rem, 6vw, 5rem); color: #fff;">roomio</h2>
        <p style="margin-top: 24px; font-size: 1.25rem; color: #a1a1a6; max-width: 600px; margin-inline: auto;">
          Bộ công cụ toàn diện giúp chủ trọ giải phóng thời gian và vận hành kinh doanh nhẹ nhàng hơn.
        </p>
      </div>

      <div class="apple-grid">
        <!-- Main Feature (Large) -->
        <article class="apple-card apple-card--span-4 apple-card--row-2 reveal">
          <h3 class="apple-gradient-text">ALL-IN-ONE.</h3>
          <p>Tất cả phòng, khách thuê, hợp đồng và hóa đơn trên một màn hình duy nhất.</p>
          <div class="apple-visual">
            <span style="color: #fff; font-weight: bold; opacity: 0.2; font-size: 1.5rem;">[ Ảnh Dashboard roomio ]</span>
            <div class="apple-visual-edge"></div>
          </div>
        </article>

        <!-- Secondary Feature (Normal) -->
        <article class="apple-card apple-card--span-2 reveal" style="transition-delay: 0.1s;">
          <h3 class="apple-gradient-text--blue">Tự động.</h3>
          <p>Hệ thống tự động tính toán điện nước và gửi thông báo cước hàng tháng qua Zalo/Email cho khách thuê. Không trễ hẹn.</p>
        </article>

        <!-- Secondary Feature (Normal) -->
        <article class="apple-card apple-card--span-2 reveal" style="transition-delay: 0.2s;">
          <h3 class="apple-gradient-text--green">Số hoá.</h3>
          <p>Ký kết và quản lý hợp đồng điện tử. Tự động cảnh báo trước khi hợp đồng sắp hết hạn.</p>
        </article>

        <!-- Wide Feature (Wide) -->
        <article class="apple-card apple-card--span-3 reveal">
          <h3>Sự cố & Bảo trì</h3>
          <p>Tiếp nhận và theo dõi tiến độ xử lý sự cố từ người thuê trực tiếp trên ứng dụng.</p>
          <div class="apple-visual" style="min-height: 120px;">
            <span style="color: #fff; font-weight: bold; opacity: 0.2;">[ Ảnh Báo cáo sự cố ]</span>
          </div>
        </article>

        <!-- Normal Feature (Normal) -->
        <article class="apple-card apple-card--span-3 reveal">
          <h3>Nhân viên & Phân quyền</h3>
          <p>Cấp quyền quản lý cho từng nhân viên theo từng tòa nhà cụ thể một cách an toàn.</p>
        </article>
      </div>
    </section>
  </main>
</Layout>
