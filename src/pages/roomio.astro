---
import Layout from '../layouts/Layout.astro'
import RoomieverseLabsLogo from '../components/RoomieverseLabsLogo.astro'
---

<Layout title="roomio · Vận hành & quản lý phòng cho thuê">
  <main>
    <div class="carousel-container" id="roomio-carousel" style="padding-top: 180px; padding-bottom: 80px; min-height: 100vh;">
      <div class="carousel-track">
        <!-- Page 1 -->
        <div class="carousel-slide">
          <div class="keynote-grid">
            <!-- Forced Centerpiece -->
            <article class="keynote-card keynote-card--centerpiece reveal" style="display: flex; align-items: center; justify-content: center;">
              <img src="/brand/roomio.png" alt="roomio logo" style="max-width: 70%; max-height: 70%; object-fit: contain;" />
            </article>

            <!-- 1. Big Text (R1-R2, C1-C2) -->
            <article class="keynote-card keynote-card--text-hero keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.1s;">
              <h3 class="keynote-gradient-text">TỰ ĐỘNG<br/>HOÀN TOÀN</h3>
              <p style="margin-top: 12px;">Tính bill & gửi thông báo nhắc nợ không trễ hẹn.</p>
            </article>

            <!-- 2. Chip (R1-R2, C3-C4) -->
            <article class="keynote-card keynote-card--chip keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.15s; flex-direction: column; justify-content: center;">
              <div class="keynote-chip-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
              </div>
              <h3>Hợp đồng số</h3>
            </article>

            <!-- 3. Chip (R1-R2, C5-C6) -->
            <article class="keynote-card keynote-card--chip keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.2s; flex-direction: column; justify-content: center;">
              <div class="keynote-chip-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
              </div>
              <h3>Phân quyền</h3>
            </article>

            <!-- 4. Tall Card (R1-R4, C7-C8) -->
            <article class="keynote-card keynote-card--col-2 keynote-card--row-4 reveal" style="transition-delay: 0.25s; justify-content: flex-end;">
              <span style="color: #1d1d1f; font-weight: bold; font-size: 1.2rem; text-align: center; margin-bottom: 20px;">Báo cáo trực quan</span>
            </article>

            <!-- 5. Chip (R3-R4, C1-C2) -->
            <article class="keynote-card keynote-card--chip keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.3s; flex-direction: column; justify-content: center;">
              <div class="keynote-chip-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
              </div>
              <h3>Bảo trì sự cố</h3>
            </article>

            <!-- 6. Wide Image Card (R5-R6, C1-C6) -->
            <article class="keynote-card keynote-card--col-6 keynote-card--row-2 reveal" style="transition-delay: 0.45s; align-items: center; justify-content: center;">
              <h3 style="color: #1d1d1f; margin: 0; font-size: 1.5rem;">Quản lý tập trung trên một Dashboard</h3>
            </article>

            <!-- 7. Medium Card (R5-R6, C7-C8) -->
            <article class="keynote-card keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.5s; justify-content: flex-end;">
              <span style="color: #1d1d1f; font-weight: bold; font-size: 1.2rem; text-align: center; margin-bottom: 20px;">Tình trạng phòng</span>
            </article>
          </div>
        </div>

        <!-- Page 2 -->
        <div class="carousel-slide">
          <div class="keynote-grid">
            <!-- Forced Centerpiece -->
            <article class="keynote-card keynote-card--centerpiece" style="display: flex; align-items: center; justify-content: center;">
              <img src="/brand/roomio.png" alt="roomio logo" style="max-width: 70%; max-height: 70%; object-fit: contain;" />
            </article>

            <!-- 1. Big Text (R1-R2, C1-C2) -->
            <article class="keynote-card keynote-card--text-hero keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.1s;">
              <h3 class="keynote-gradient-text" style="font-size: 2rem;">TÍNH NĂNG<br/>MỚI</h3>
              <p style="margin-top: 12px;">Đang được cập nhật liên tục.</p>
            </article>

            <!-- 2. Chip (R1-R2, C3-C4) -->
            <article class="keynote-card keynote-card--chip keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.15s; flex-direction: column; justify-content: center;">
              <div class="keynote-chip-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              </div>
              <h3>Camera AI</h3>
            </article>

            <!-- 3. Chip (R1-R2, C5-C6) -->
            <article class="keynote-card keynote-card--chip keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.2s; flex-direction: column; justify-content: center;">
              <div class="keynote-chip-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
              </div>
              <h3>Thanh toán QR</h3>
            </article>

            <!-- 4. Tall Card (R1-R4, C7-C8) -->
            <article class="keynote-card keynote-card--col-2 keynote-card--row-4 reveal" style="transition-delay: 0.25s; justify-content: flex-end; cursor: pointer; border: 2px solid var(--blue);" onclick="document.getElementById('pricing').scrollIntoView({behavior: 'smooth'})">
              <span style="color: var(--blue); font-weight: bold; font-size: 1.5rem; text-align: center; margin-bottom: 20px;">Xem Bảng Giá<br/>↓</span>
            </article>

            <!-- 5. Chip (R3-R4, C1-C2) -->
            <article class="keynote-card keynote-card--chip keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.3s; flex-direction: column; justify-content: center;">
              <div class="keynote-chip-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              </div>
              <h3>Gói VIP</h3>
            </article>

            <!-- 6. Wide Image Card (R5-R6, C1-C6) -->
            <article class="keynote-card keynote-card--col-6 keynote-card--row-2 reveal" style="transition-delay: 0.45s; align-items: center; justify-content: center;">
              <h3 style="color: #1d1d1f; margin: 0; font-size: 1.5rem;">Giao tiếp với khách thuê trực tiếp trên ứng dụng</h3>
            </article>

            <!-- 7. Medium Card (R5-R6, C7-C8) -->
            <article class="keynote-card keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.5s; justify-content: flex-end;">
              <span style="color: #1d1d1f; font-weight: bold; font-size: 1.2rem; text-align: center; margin-bottom: 20px;">Lịch sử bảo trì</span>
            </article>
          </div>
        </div>

        <!-- Page 3 -->
        <div class="carousel-slide" style="align-items: center; justify-content: center; padding: 2rem;">
          <h2 style="color: #0071e3; font-weight: 700; font-size: clamp(2rem, 5vw, 4rem); max-width: 900px; line-height: 1.2; margin-bottom: 40px; text-align: center;">
            Trải nghiệm việc quản lý phòng cho thuê dễ dàng nhất có thể
          </h2>
          <img src="/brand/roomio.png" alt="roomio logo" style="max-height: 100px; margin-bottom: 40px; object-fit: contain;" />
          <div style="display: flex; gap: 20px; align-items: center; justify-content: center; flex-wrap: wrap;">
            <a href="https://roomio.roomieverse.me" target="_blank" class="cta-btn" style="--hover-bg: #0071e3; border: 1px solid #0071e3; color: #0071e3;" onmouseenter="const r=this.getBoundingClientRect(); this.style.setProperty('--x', event.clientX - r.left + 'px'); this.style.setProperty('--y', event.clientY - r.top + 'px');">
              Thử ngay
            </a>
            <a href="https://roomiodemo.roomieverse.me" target="_blank" class="cta-btn" style="--hover-bg: #1d1d1f; border: 1px solid #1d1d1f; color: #1d1d1f;" onmouseenter="const r=this.getBoundingClientRect(); this.style.setProperty('--x', event.clientX - r.left + 'px'); this.style.setProperty('--y', event.clientY - r.top + 'px');">
              Bản dùng thử
            </a>
          </div>
        </div>
      </div>
      
      <div class="carousel-dots">
        <button class="carousel-dot active" aria-label="Page 1"></button>
        <button class="carousel-dot" aria-label="Page 2"></button>
        <button class="carousel-dot" aria-label="Page 3"></button>
      </div>
      
      <style>
        #roomio-carousel .carousel-arrow {
          color: #1d1d1f;
          background: rgba(0,0,0,0.05);
        }
        #roomio-carousel .carousel-arrow:hover {
          background: rgba(0,0,0,0.1);
        }
      </style>
      <button class="carousel-arrow carousel-arrow--prev" aria-label="Previous" style="display: none;">&#10094;</button>
      <button class="carousel-arrow carousel-arrow--next" aria-label="Next">&#10095;</button>
    </div>

    <!-- PRICING SECTION -->
    <section id="pricing" style="padding: 120px 20px; max-width: 1200px; margin: 0 auto; background: #fff; color: #1d1d1f;">
      <div style="text-align: center; margin-bottom: 80px;">
        <h2 style="font-size: clamp(2.5rem, 5vw, 4rem); margin-bottom: 20px;">Bảng giá linh hoạt cho mọi quy mô</h2>
        <p style="font-size: 1.2rem; color: #86868b; max-width: 700px; margin: 0 auto;">Miễn phí 6 tháng đầu cho quy mô nhỏ. Nâng cấp đặc quyền VIP khi vượt mốc 50 phòng.</p>
      </div>

      <div class="apple-grid" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px; margin-bottom: 80px;">
        <!-- Standard -->
        <article class="apple-card" style="background: #f5f5f7; display: flex; flex-direction: column; padding: 40px;">
          <h3 style="font-size: 2rem; margin-bottom: 10px;">Tiêu chuẩn</h3>
          <p style="color: #86868b; margin-bottom: 30px;">Quy mô dưới 50 phòng — Tự phục vụ</p>
          <div style="font-size: 3rem; font-weight: 700; margin-bottom: 10px; display: flex; align-items: baseline; gap: 8px;">
            169k <span style="font-size: 1rem; color: #86868b; font-weight: 400;">/tháng</span>
          </div>
          <p style="font-size: 0.9rem; color: #86868b; margin-bottom: 40px;">Bắt đầu tính phí từ phòng thứ 5. Miễn phí 6 tháng đầu từ 1-4 phòng.</p>
          <a href="#" class="cta-btn" style="text-align: center; --hover-bg: #1d1d1f; background: #fff; color: #1d1d1f; border: 1px solid #1d1d1f; margin-bottom: 40px;">Dùng thử miễn phí</a>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 16px;">
            <li style="display: flex; gap: 12px; align-items: flex-start;"><span style="color: var(--blue);">✓</span> Tính bill & Gửi thông báo tự động</li>
            <li style="display: flex; gap: 12px; align-items: flex-start;"><span style="color: var(--blue);">✓</span> Quản lý Hợp đồng số</li>
            <li style="display: flex; gap: 12px; align-items: flex-start;"><span style="color: var(--blue);">✓</span> Báo cáo cơ bản</li>
            <li style="display: flex; gap: 12px; align-items: flex-start;"><span style="color: var(--blue);">✓</span> Giá ưu đãi cho Co-living/Share</li>
          </ul>
        </article>

        <!-- VIP Operator -->
        <article class="apple-card" style="background: var(--blue); color: #fff; display: flex; flex-direction: column; padding: 40px; position: relative; overflow: hidden;">
          <div style="position: absolute; top: 0; right: 0; background: var(--pink); color: var(--pink-ink); font-weight: bold; font-size: 0.8rem; padding: 8px 24px; border-bottom-left-radius: 20px;">PHỔ BIẾN NHẤT</div>
          <h3 style="font-size: 2rem; margin-bottom: 10px; color: #fff;">VIP Operator</h3>
          <p style="color: rgba(255,255,255,0.7); margin-bottom: 30px;">Quy mô trên 50 phòng — Đặc quyền VIP</p>
          <div style="font-size: 3rem; font-weight: 700; margin-bottom: 10px; display: flex; align-items: baseline; gap: 8px;">
            1.489k <span style="font-size: 1rem; color: rgba(255,255,255,0.7); font-weight: 400;">/tháng</span>
          </div>
          <p style="font-size: 0.9rem; color: rgba(255,255,255,0.7); margin-bottom: 40px;">Giảm 50% tháng đầu tiên trải nghiệm.</p>
          <a href="#" class="cta-btn" style="text-align: center; background: #fff; color: var(--blue); border: none; margin-bottom: 40px;">Liên hệ tư vấn</a>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 16px;">
            <li style="display: flex; gap: 12px; align-items: flex-start;"><span style="color: var(--pink);">✓</span> Mọi tính năng của Tiêu chuẩn</li>
            <li style="display: flex; gap: 12px; align-items: flex-start;"><span style="color: var(--pink);">✓</span> White-glove Onboarding (Bao setup A-Z)</li>
            <li style="display: flex; gap: 12px; align-items: flex-start;"><span style="color: var(--pink);">✓</span> Kênh Zalo VIP 1-1 (SLA 5 phút)</li>
            <li style="display: flex; gap: 12px; align-items: flex-start;"><span style="color: var(--pink);">✓</span> Phân quyền STAFF chi tiết</li>
            <li style="display: flex; gap: 12px; align-items: flex-start;"><span style="color: var(--pink);">✓</span> Báo cáo P&L dòng tiền nâng cao</li>
          </ul>
        </article>
      </div>
      
      <div style="background: #f5f5f7; border-radius: 30px; padding: 40px; display: flex; flex-wrap: wrap; gap: 40px; align-items: center; justify-content: space-between;">
        <div>
          <h4 style="font-size: 1.5rem; margin-bottom: 10px;">Chính sách tính gộp/tách thông minh</h4>
          <p style="color: #86868b; max-width: 600px;">Đối với danh mục kết hợp (Trọ chuẩn + Co-living), Roomio tự động tính cả hai phương án Gộp hoặc Tách, và tự động chọn phương án giá <strong>rẻ hơn</strong> cho bạn.</p>
        </div>
        <img src="/brand/roomio.png" alt="roomio logo" style="height: 60px; object-fit: contain;" />
      </div>
    </section>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const carousels = document.querySelectorAll('.carousel-container');
        carousels.forEach(carousel => {
          const track = carousel.querySelector('.carousel-track');
          const dots = carousel.querySelectorAll('.carousel-dot');
          const prevBtn = carousel.querySelector('.carousel-arrow--prev');
          const nextBtn = carousel.querySelector('.carousel-arrow--next');
          let currentIndex = 0;
          
          const updateCarousel = (index) => {
            currentIndex = index;
            track.style.transform = `translateX(-${index * 50}%)`;
            dots.forEach(d => d.classList.remove('active'));
            if (dots[index]) dots[index].classList.add('active');
            
            if (prevBtn && nextBtn) {
              prevBtn.style.display = index === 0 ? 'none' : 'flex';
              nextBtn.style.display = index === dots.length - 1 ? 'none' : 'flex';
            }
          };

          dots.forEach((dot, index) => {
            dot.addEventListener('click', () => updateCarousel(index));
          });
          
          if (prevBtn) prevBtn.addEventListener('click', () => updateCarousel(Math.max(0, currentIndex - 1)));
          if (nextBtn) nextBtn.addEventListener('click', () => updateCarousel(Math.min(dots.length - 1, currentIndex + 1)));
        });
        
        const grids = document.querySelectorAll('.keynote-grid');
        
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const cards = entry.target.querySelectorAll('.keynote-card');
              cards.forEach((card, index) => {
                setTimeout(() => {
                  card.classList.add('reveal-active');
                  card.style.opacity = '1';
                  card.style.transform = 'translateY(0) scale(1)';
                }, index * 50);
              });
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1 });

        grids.forEach(grid => observer.observe(grid));
      });
    </script>
  </main>
</Layout>
