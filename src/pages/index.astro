---
import '../styles/global.css'
import RoomieverseLabsLogo from '../components/RoomieverseLabsLogo.astro'

const products = [
  {
    name: 'roomio',
    role: 'Vận hành nhà trọ',
    description: 'Dành cho chủ trọ quản lý tòa nhà, phòng, khách thuê, hợp đồng, hóa đơn, thu tiền, sự cố và nhân viên ở cùng một nơi.',
    logo: '/brand/roomio.png',
    logoAlt: 'Roomio',
    accent: 'blue',
    metrics: ['Tòa nhà', 'Hợp đồng', 'Hóa đơn'],
  },
  {
    name: 'roomieverse',
    role: 'Tìm phòng và người ở cùng',
    description: 'Kết nối người tìm phòng và roommate dựa trên lối sống, thói quen và sở thích — minh bạch, không môi giới.',
    logo: '/brand/roomieverse-cropped.png',
    logoAlt: 'Roomieverse',
    accent: 'pink',
    metrics: ['Tìm phòng', 'Tìm bạn', 'Phòng chung'],
  },
  {
    name: 'roomibase',
    role: 'Tìm chỗ ở trực tiếp',
    description: 'Kết nối chủ nhà và người thuê để tìm phòng trọ, căn hộ, nhà riêng và phòng dịch vụ trực tiếp, không qua trung gian.',
    logo: '/brand/roomibase-rounded.png',
    logoAlt: 'Roomibase',
    accent: 'navy',
    metrics: ['Chủ nhà', 'Người thuê', 'Chỗ ở'],
  },
]

const journey = [
  ['01', 'Tìm chỗ ở', 'Roomibase giúp người thuê gặp trực tiếp chủ nhà và xem những lựa chọn phù hợp.'],
  ['02', 'Cũng là tìm chỗ ở, nhưng...', 'Roomieverse giúp tìm người ở cùng dựa trên thói quen và nhịp sống.'],
  ['03', 'Vận hành gọn', 'Roomio giúp chủ trọ quản lý mọi việc sau khi căn phòng đã có người ở.'],
]
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Roomio, Roomieverse và Roomibase — bộ ba sản phẩm đi cùng hành trình tìm chỗ ở, tìm người ở cùng và quản lý vận hành nhà trọ." />
    <meta name="theme-color" content="#2563eb" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:title" content="Roomio · Roomieverse · Roomibase" />
    <meta property="og:description" content="Ba sản phẩm cho một hành trình ở liền mạch." />
    <meta property="og:image" content="/brand/roomieverse.png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Roomio · Roomieverse · Roomibase</title>
  </head>
  <body>
    <div class="preloader" aria-hidden="true">
      <div class="preloader-content">
        <div class="preloader-logos">
          <img class="preloader-logo preloader-logo--roomio" src="/brand/roomio.png" width="611" height="176" alt="" />
          <span class="preloader-divider"></span>
          <img class="preloader-logo preloader-logo--verse" src="/brand/roomieverse-stacked-cropped.png" width="813" height="397" alt="" />
          <span class="preloader-divider"></span>
          <img class="preloader-logo preloader-logo--base" src="/brand/roomibase-rounded.png" width="1603" height="308" alt="" />
        </div>
        <div class="preloader-credit"><RoomieverseLabsLogo /></div>
      </div>
    </div>

    <header class="topbar" aria-label="Điều hướng chính">
      <a class="brand" href="#hero" aria-label="RoomieVerse Labs — về đầu trang">
        <RoomieverseLabsLogo />
      </a>
      <div class="topbar-actions">
        <div class="lang-switch">
          <a href="/" class="is-active">VI</a>
          <span class="lang-sep">|</span>
          <a href="/en/">EN</a>
        </div>
        <button class="menu-button" type="button" aria-expanded="false" aria-controls="main-menu"><span>Menu</span><i aria-hidden="true"></i></button>
      </div>
    </header>

    <aside class="menu-overlay" id="main-menu" aria-hidden="true">
      <div class="menu-head">
        <div class="menu-logos">
          <img class="menu-logo menu-logo--roomio" src="/brand/roomio.png" width="611" height="176" alt="" />
          <span class="menu-divider"></span>
          <img class="menu-logo menu-logo--verse" src="/brand/roomieverse-stacked-cropped.png" width="813" height="397" alt="" />
          <span class="menu-divider"></span>
          <img class="menu-logo menu-logo--base" src="/brand/roomibase-rounded.png" width="1603" height="308" alt="" />
        </div>
        <button class="menu-close" type="button" aria-label="Đóng menu">×</button>
      </div>
      <div class="menu-body">
        <nav aria-label="Menu trang">
          <a href="#hero"><span>01</span>Trang đầu</a>
          <a href="#story"><span>02</span>Hành trình ở</a>
          <a href="#products"><span>03</span>Bộ ba</a>
          <a href="#footer"><span>04</span>Cùng một nhà</a>
        </nav>
        <a class="brand brand--blue menu-brand" href="#hero" tabindex="-1">
          <RoomieverseLabsLogo />
        </a>
      </div>
      <div class="menu-orbits" aria-hidden="true"><i></i><i></i><i></i></div>
    </aside>

    <main>
      <section class="hero-scroll" id="hero">
        <div class="hero-frame">
          <div class="hero-shell">
            <div class="hero-copy">
              <h1>Trải nghiệm việc <em>thuê</em> và <em>cho thuê</em> chỗ ở<br />trở nên <strong style="color: var(--pink); font-size: 1.15em; font-weight: 900;">tốt hơn.</strong></h1>
            </div>
            
            <div class="scroll-cue"><span>Cuộn để xem</span><i>↓</i></div>
          </div>
        </div>
      </section>

      <section class="menu-section" id="products" aria-labelledby="products-title">
        <div class="section-title reveal">
          <h2 id="products-title">Bọn mình có gì<span style="color: var(--pink)">?</span></h2>
        </div>

        <div class="dish-list product-list">
          {products.map((product, index) => (
            <article class={`dish-card product-card product-card--${product.accent} reveal`}>
              <div class="dish-media product-visual">
                <span>0{index + 1}</span>
                <div class="product-window" aria-hidden="true">
                  <div class="product-window-bar"><i></i><i></i><i></i><small>{product.name}</small></div>
                  <div class="product-window-body">
                    <div class="product-sidebar"><b></b><i></i><i></i><i></i><i></i></div>
                    <div class="product-dashboard">
                      <img src={product.logo} width={product.name === 'roomieverse' ? '640' : product.name === 'roomibase' ? '981' : '611'} height={product.name === 'roomieverse' ? '640' : product.name === 'roomibase' ? '178' : '176'} alt="" />
                      <div class="product-metrics">{product.metrics.map((metric, metricIndex) => <div><span>{metric}</span><strong>{metricIndex === 0 ? '24' : metricIndex === 1 ? '08' : '96%'}</strong></div>)}</div>
                      <div class="product-chart"><i></i><i></i><i></i><i></i><i></i><i></i></div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="dish-copy"><small>{product.role}</small><h3>{product.name}</h3><p>{product.description}</p></div>
            </article>
          ))}
        </div>

        <div class="topping-heading reveal" id="story">
          <h3>Một hành trình liền mạch</h3>
          <p><mark>roomieVerse Labs</mark> sẽ đồng hành cùng mọi người trong suốt quá trình tìm chỗ ở,<br />trong lúc ở cho tới việc quản lý chỗ ở đối với người cho thuê.</p>
        </div>
        <div class="toppings-grid journey-grid">
          {journey.map(([number, title, description], index) => (
            <article class={`topping-card journey-card journey-card--${index + 1} reveal`}><span>{number}</span><i aria-hidden="true"></i><h3>{title}</h3><p>{description}</p></article>
          ))}
        </div>
      </section>
    </main>

    <footer class="footer" id="footer">
      <div class="footer-card footer-card--contact reveal">
        <div class="footer-row">
          <h4 class="footer-row-title">Sản phẩm</h4>
          <div class="footer-row-links">
            <a href="#">roomio</a>
            <a href="#">roomieVerse</a>
            <a href="#">roomibase</a>
          </div>
        </div>
        <div class="footer-row">
          <h4 class="footer-row-title">Liên hệ</h4>
          <div class="footer-row-links">
            <a href="mailto:hello@roomieverselabs.com">hello@roomieverselabs.com</a>
          </div>
        </div>
        <div class="footer-row footer-row--bottom">
          <a href="#story">About</a>
          <a href="#">Threads</a>
          <a href="#">Facebook</a>
          <a href="#">X</a>
          <a href="#">Privacy & Terms</a>
        </div>
      </div>
      <div class="footer-card footer-card--logo reveal">
        <RoomieverseLabsLogo />
      </div>
    </footer>

    <a class="floating-menu" href="#products">Xem bộ ba</a>

    <script is:inline>
      const clamp = (value, min = 0, max = 1) => Math.min(max, Math.max(min, value));
      const smoothstep = (value) => { const x = clamp(value); return x * x * (3 - 2 * x); };
      const body = document.body;
      const preloader = document.querySelector('.preloader');
      const menu = document.querySelector('.menu-overlay');
      const menuButton = document.querySelector('.menu-button');
      const menuClose = document.querySelector('.menu-close');
      const hero = document.querySelector('.hero-scroll');
      const heroFrame = document.querySelector('.hero-frame');
      const heroShell = document.querySelector('.hero-shell');
      const heroCopy = document.querySelector('.hero-copy');
      const footer = document.querySelector('.footer');
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let ticking = false;

      function updateHero() {
        const progress = clamp(-hero.getBoundingClientRect().top / Math.max(1, innerHeight * .7));
        const morph = smoothstep((progress - .04) / .58);
        const fade = smoothstep((progress - .08) / .46);
        const inset = innerWidth <= 700 ? 9 : 22;
        const radius = innerWidth <= 700 ? 38 : 82;
        
        // Outer frame fades from dark blue to paper-blue to hide the seam with the next section
        heroFrame.style.backgroundColor = `rgb(${Math.round(6 + 239 * morph)},${Math.round(22 + 226 * morph)},${Math.round(56 + 199 * morph)})`;
        
        // Inner shell fades from roomieverse-blue to paper-blue
        heroShell.style.backgroundColor = `rgb(${Math.round(147 + 98 * morph)},${Math.round(197 + 51 * morph)},${Math.round(253 + 2 * morph)})`;
        heroShell.style.inset = `${inset * (1 - morph)}px`;
        heroShell.style.borderRadius = `${radius * (1 - morph)}px`;
        heroCopy.style.opacity = String(1 - fade);
        heroCopy.style.transform = `translate(-50%, calc(-50% - ${fade * 45}px)) scale(${1 - fade * .03})`;
        
        body.classList.toggle('past-hero', hero.getBoundingClientRect().bottom < innerHeight * .35);
      }

      function updatePage() { updateHero(); ticking = false; }
      function requestUpdate() { if (!ticking) { ticking = true; requestAnimationFrame(updatePage); } }
      function setMenu(open) { menu.classList.toggle('is-open', open); body.classList.toggle('menu-open', open); menu.setAttribute('aria-hidden', String(!open)); menuButton.setAttribute('aria-expanded', String(open)); if (open) menuClose.focus({ preventScroll: true }); else menuButton.focus({ preventScroll: true }); }

      menuButton.addEventListener('click', () => setMenu(true));
      menuClose.addEventListener('click', () => setMenu(false));
      menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && menu.classList.contains('is-open')) setMenu(false); });
      const revealObserver = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); revealObserver.unobserve(entry.target); } }), { threshold: .12, rootMargin: '0px 0px -45px' });
      document.querySelectorAll('.reveal').forEach((element) => revealObserver.observe(element));
      const footerObserver = new IntersectionObserver(([entry]) => body.classList.toggle('at-footer', entry.isIntersecting), { threshold: .08 });
      footerObserver.observe(footer);
      addEventListener('scroll', requestUpdate, { passive: true });
      addEventListener('resize', requestUpdate);
      addEventListener('load', () => { setTimeout(() => { preloader.classList.add('is-hidden'); body.classList.add('is-loaded'); }, 680); updatePage(); });
      updatePage();
    </script>
  </body>
</html>
