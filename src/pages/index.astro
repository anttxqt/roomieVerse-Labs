---
import '../styles/global.css'
import RoomieverseLabsLogo from '../components/RoomieverseLabsLogo.astro'
import Layout from '../layouts/Layout.astro'

const products = [
  {
    name: 'roomio',
    role: 'Vận hành & quản lý phòng cho thuê',
    description: 'Dành cho chủ trọ quản lý tòa nhà, phòng, khách thuê, hợp đồng, hóa đơn, thu tiền, sự cố và nhân viên ở cùng một nơi. Gửi thông báo nhắc nợ hàng tháng, gửi bill tự động.',
    logo: '/brand/roomio.png',
    logoAlt: 'Roomio',
    titleLogo: '/brand/roomio.png',
    accent: 'blue',
    metrics: ['Tòa nhà', 'Hợp đồng', 'Hóa đơn'],
    link: '/roomio',
    linkText: 'Tìm hiểu thêm',
  },
  {
    name: 'roomieverse',
    role: 'Tìm phòng share - tìm bạn ở ghép',
    description: 'Dành cho sinh viên, người đi làm xa quê muốn kiếm người ở ghép phù hợp với tiêu chí lối sống. Tìm phòng share lại trong căn hộ chung cư hay nhà nguyên căn. Tất cả trực tiếp và không qua môi giới.',
    logo: '/brand/roomieverse-cropped.png',
    logoAlt: 'Roomieverse',
    titleLogo: '/brand/roomieverse.png',
    accent: 'pink',
    metrics: ['Tìm phòng', 'Tìm bạn', 'Phòng chung'],
    link: '/roomieverse',
    linkText: 'Tìm hiểu thêm',
  },
  {
    name: 'roomibase',
    role: 'Tìm phòng, tìm nhà cho thuê',
    description: 'Dành cho người muốn tìm trọ hoặc tìm nhà, căn hộ cho thuê nguyên căn. Có thể qua trung gian môi giới hoặc trực tiếp.',
    logo: '/brand/roomibase-rounded.png',
    logoAlt: 'Roomibase',
    titleLogo: '/brand/roomibase-rounded.png',
    accent: 'navy',
    metrics: ['Chủ nhà', 'Người thuê', 'Chỗ ở'],
    comingSoon: true,
    link: '/roomieverse',
    linkText: 'Tìm hiểu thêm',
  },
]

const journey = [
  ['01', 'Tìm chỗ ở', 'Roomibase giúp người thuê gặp trực tiếp chủ nhà và xem những lựa chọn phù hợp.'],
  ['02', 'Cũng là tìm chỗ ở, nhưng...', 'Roomieverse giúp tìm người ở cùng dựa trên thói quen và nhịp sống.'],
  ['03', 'Vận hành gọn', 'Roomio giúp chủ trọ quản lý mọi việc sau khi căn phòng đã có người ở.'],
]
---

<Layout>    <main>
      <section class="hero-scroll" id="hero">
        <div class="hero-frame">
          <div class="hero-shell">
            <div class="hero-copy">
              <h1>Trải nghiệm việc <em>thuê</em> và <em>cho thuê</em> chỗ ở<br />trở nên <strong style="color: var(--pink); font-size: 1.15em; font-weight: 900;">tốt hơn.</strong></h1>
            </div>
            
            <div class="scroll-cue"><span>Cuộn để xem</span><i>↓</i></div>
          </div>
        </div>
      </section>

      <section class="menu-section">
        <div class="topping-heading reveal" id="story">
          <h3>Một hành trình liền mạch</h3>
          <p><mark>roomieVerse Labs</mark> sẽ đồng hành cùng mọi người trong suốt quá trình tìm chỗ ở,<br />trong lúc ở đối với người đi thuê cho tới việc quản lý chỗ ở đối với người cho thuê.</p>
        </div>
        <div class="toppings-grid journey-grid">
          {journey.map(([number, title, description], index) => (
            <article class={`topping-card journey-card journey-card--${index + 1} reveal`}><span>{number}</span><i aria-hidden="true"></i><h3>{title}</h3><p>{description}</p></article>
          ))}
        </div>

        <div class="section-title reveal" id="products" aria-labelledby="products-title">
          <h2 id="products-title">Vậy<span style="color: var(--roomibase)">,</span> bọn mình có gì<span style="color: var(--pink)">?</span></h2>
        </div>

        <div class="dish-list product-list">
          {products.map((product, index) => (
            <article class={`dish-card product-card product-card--${product.accent} reveal`}>
              <div class="product-visual">
                <img src={product.logo} class="product-hero-logo" alt="" aria-hidden="true" />
              </div>
              <div class="dish-copy">
                <small>
                  {product.role}
                  {product.comingSoon && <span class="badge badge--coming-soon">Đang phát triển</span>}
                </small>
                <p>{product.description}</p>
                <div style="margin-top: 16px; display: flex; gap: 12px; flex-wrap: wrap;">
                  {product.link && (
                    <a href={product.link} class="product-action"><span>{product.linkText}</span></a>
                  )}
                  {product.comingSoon && (
                    <a href="#footer" class="product-action"><span>Nhận thông báo khi ra mắt</span></a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>
</Layout>
