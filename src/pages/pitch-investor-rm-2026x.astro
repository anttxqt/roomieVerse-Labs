const breakevenDotGridCols = 56
const breakevenDotGridRows = 20
const breakevenDotCount = breakevenDotGridCols * breakevenDotGridRows
const breakevenBlueDotCount = 26
const breakevenBlueStartCol = breakevenDotGridCols - breakevenBlueDotCount

function breakevenDotIsBlue(index: number) {
  const col = index % breakevenDotGridCols
  const row = Math.floor(index / breakevenDotGridCols)
  return row === 0 && col >= breakevenBlueStartCol
}

function parsePitchVnd(value) {
  if (!value || value === '–') return 0
  return Number(String(value).replace(/\./g, '').replace(/[^\d]/g, '')) || 0
}

const pitchFocusPrefixRules = [
  ['Dev', 'product'],
  ['Máy trạm', 'product'],
  ['Hạ tầng cloud', 'product'],
  ['CEO', 'growth'],
  ['Sale chính', 'growth'],
  ['CTV', 'growth'],
  ['Marketing', 'growth'],
  ['Văn phòng làm việc', 'ops'],
  ['Vận hành', 'ops'],
  ['Pháp lý', 'ops'],
  ['Dự phòng', 'reserve'],
] as const

function pitchFocusWeightsForKhoan(khoan) {
  if (khoan.startsWith('Founder')) return { growth: 0.5, product: 0.5 }
  for (const [prefix, key] of pitchFocusPrefixRules) {
    if (khoan.startsWith(prefix)) return { [key]: 1 }
  }
  throw new Error(`pitchTableA row has no focus prefix: ${khoan}`)
}


function formatPitchFocusAmount(vnd) {
  if (vnd >= 1e9) {
    const tyRounded = Math.round(vnd / 1e7) / 100
    const intPart = Math.floor(tyRounded)
    const decPart = Math.round((tyRounded - intPart) * 100)
    const decText = String(decPart).padStart(2, '0')
    return decText === '00' ? `~${intPart} tỷ` : `~${intPart},${decText} tỷ`
  }
  const trieu = Math.round(vnd / 1e6)
  return `~${trieu} triệu`
}

function buildPitchFocusChart() {
  const sums = Object.fromEntries(pitchFocusGroups.map((group) => [group.key, 0]))
  for (const row of pitchTableA) {
    if (row.total) continue
    const vnd = parsePitchVnd(row.vnd)
    const weights = pitchFocusWeightsForKhoan(row.khoan)
    for (const [key, weight] of Object.entries(weights)) {
      sums[key] += vnd * weight
    }
  }
  const totalVnd = pitchFocusGroups.reduce((acc, group) => acc + sums[group.key], 0)
  const amounts = pitchFocusGroups.map((group) => sums[group.key])
  // Làm tròn thường tới 0,1% (giống bảng phân bổ), nên tổng có thể lệch 0,1–0,2.
  const percents = amounts.map((amount) => Math.round((amount / totalVnd) * 1000) / 10)
  const percentSum = percents.reduce((acc, value) => acc + value, 0)
  if (Math.abs(percentSum - 100) > 0.3) throw new Error('pitchFocusChart percent sum mismatch')

  let cursor = 0
  const stops = []
  const chart = pitchFocusGroups.map((group, index) => {
    const percent = percents[index]
    const start = cursor
    cursor = index === pitchFocusGroups.length - 1 ? 100 : Math.round((cursor + percent) * 10) / 10
    stops.push(`${group.color} ${start}% ${cursor}%`)
    return {
      ...group,
      percent,
      percentText: `${percent.toFixed(1).replace('.', ',')}%`,
      amount: formatPitchFocusAmount(sums[group.key]),
      vnd: sums[group.key],
    }
  })


  return {
    groups: chart,
    conicGradient: `conic-gradient(from 0deg, ${stops.join(', ')})`,
    ariaLabel: `Biểu đồ tròn: ${chart.map((group) => `${group.label} ${group.percentText}`).join(', ')}`,
  }
}

const pitchFocusChart = buildPitchFocusChart()

function assertPitchFundingData() {
  const sumA = pitchTableA.filter((row) => !row.total).reduce((acc, row) => acc + parsePitchVnd(row.vnd), 0)
  const pctA = pitchTableA.filter((row) => !row.total).reduce((acc, row) => acc + parseFloat(row.tyLe.replace(',', '.')), 0)
  if (sumA !== 2570000000 || Math.abs(pctA - 100) > 0.3) {
    throw new Error('pitchTableA totals mismatch')
  }

  const barPct = pitchFundingBars.reduce((acc, row) => acc + row.percent, 0)
  if (Math.abs(barPct - 100) > 0.3) throw new Error('pitchFundingBars percent mismatch')

  const monthlyTotals = pitchTableB.find((row) => row.kind === 'total' && row.label === 'CỘNG MỖI THÁNG')
  if (!monthlyTotals) throw new Error('pitchTableB missing monthly totals')
  for (let i = 0; i < 4; i += 1) {
    const colSum = pitchTableB
      .filter((row) => row.kind === 'data')
      .reduce((acc, row) => acc + parsePitchVnd(row.c[i]), 0)
    if (colSum !== parsePitchVnd(monthlyTotals.c[i])) {
      throw new Error(`pitchTableB column ${i + 1} mismatch`)
    }
  }

  const phaseTotals = pitchTableB.find((row) => row.kind === 'total' && row.label === 'CỘNG GIAI ĐOẠN')
  if (!phaseTotals) throw new Error('pitchTableB missing phase totals')
  const sumPhases = phaseTotals.c.reduce((acc, cell) => acc + parsePitchVnd(cell), 0)
  if (sumPhases !== 2255840000) throw new Error('pitchTableB phase totals mismatch')

  const sumC = pitchTableC.filter((row) => !row.total).reduce((acc, row) => acc + parsePitchVnd(row.vnd), 0)
  if (sumC !== 171450000) throw new Error('pitchTableC total mismatch')

  if (2255840000 + 171450000 !== 2427290000) {
    throw new Error('18-month budget identity mismatch')
  }

  const sumDChi = pitchTableD.reduce((acc, row) => acc + parsePitchVnd(row.chi), 0)
  if (sumDChi !== 2427290000) throw new Error('pitchTableD chi sum mismatch')
}

assertPitchFundingData()

