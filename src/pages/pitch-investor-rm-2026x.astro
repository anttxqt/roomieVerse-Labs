function parsePitchVnd(value) {
  if (!value || value === '–') return 0
  return Number(String(value).replace(/\./g, '').replace(/[^\d]/g, '')) || 0
}

function assertPitchFundingData() {
  const sumA = pitchTableA.filter((row) => !row.total).reduce((acc, row) => acc + parsePitchVnd(row.vnd), 0)
  const pctA = pitchTableA.filter((row) => !row.total).reduce((acc, row) => acc + parseInt(row.tyLe, 10), 0)
  if (sumA !== 1362100000 || pctA !== 100) {
    throw new Error('pitchTableA totals mismatch')
  }

  const barPct = pitchFundingBars.reduce((acc, row) => acc + row.percent, 0)
  if (barPct !== 100) throw new Error('pitchFundingBars percent mismatch')

  const monthlyTotals = pitchTableB.find((row) => row.kind === 'total' && row.label === 'CỘNG MỖI THÁNG')
  if (!monthlyTotals) throw new Error('pitchTableB missing monthly totals')
  for (let i = 0; i < 4; i += 1) {
    const colSum = pitchTableB
      .filter((row) => row.kind === 'data')
      .reduce((acc, row) => acc + parsePitchVnd(row.c[i]), 0)
    if (colSum !== parsePitchVnd(monthlyTotals.c[i])) {
      throw new Error(`pitchTableB column ${i + 1} mismatch`)
    }
  }

  const sumC = pitchTableC.filter((row) => !row.total).reduce((acc, row) => acc + parsePitchVnd(row.vnd), 0)
  if (sumC !== 187398000) throw new Error('pitchTableC total mismatch')

  const monthly12 = 1048160000
  const reserve = 126542000
  if (monthly12 + sumC + reserve !== 1362100000) {
    throw new Error('12-month budget identity mismatch')
  }
}

assertPitchFundingData()

