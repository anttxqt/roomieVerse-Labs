const appendix2ImageGlob = import.meta.glob('../assets/pitch/appendix-2/*.{png,jpg,jpeg,webp}', {
  eager: true,
  import: 'default',
}) as Record<string, ImageMetadata>

function appendix2Basename(path: string) {
  return path.split('/').pop()?.split('?')[0]?.toLowerCase() ?? ''
}

function appendix2ImageByBase(base: string): ImageMetadata | undefined {
  const lower = base.toLowerCase()
  for (const [path, meta] of Object.entries(appendix2ImageGlob)) {
    const name = appendix2Basename(path)
    if (
      name === `${lower}.png` ||
      name === `${lower}.jpg` ||
      name === `${lower}.jpeg` ||
      name === `${lower}.webp`
    ) {
      return meta
    }
  }
  return undefined
}

