---
import '../styles/global.css'
import RoomieverseLabsLogo from '../components/RoomieverseLabsLogo.astro'
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <title>roomio - Pitch Deck</title>
    <style>
      .pitch-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 64px;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 24px;
        z-index: 100;
        border-bottom: 1px solid var(--line);
      }
      
      .pitch-badge {
        background: var(--blue-soft);
        color: var(--blue-dark);
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
      }
      
      .slide-section {
        padding: 120px 20px;
        max-width: 1200px;
        margin: 0 auto;
        color: #1d1d1f;
      }
      
      .slide-section--dark {
        background-color: var(--blue-deep);
        color: white;
        max-width: 100%;
        padding-left: 20px;
        padding-right: 20px;
      }
      
      .slide-section--alt {
        background-color: #f5f5f7;
        max-width: 100%;
        padding-left: 20px;
        padding-right: 20px;
      }
      
      .slide-container {
        max-width: 1200px;
        margin: 0 auto;
      }
      
      .slide-title {
        font-size: clamp(2.5rem, 5vw, 4rem);
        line-height: 1.1;
        margin-bottom: 30px;
        letter-spacing: -0.04em;
        text-align: center;
        max-width: 900px;
        margin-left: auto;
        margin-right: auto;
      }
      
      .slide-content {
        font-size: clamp(1.1rem, 1.5vw, 1.25rem);
        line-height: 1.6;
        color: #86868b;
        max-width: 800px;
        margin: 0 auto;
        text-align: center;
      }
      
      .slide-section--dark .slide-content {
        color: rgba(255, 255, 255, 0.7);
      }
      
      .slide-content ul {
        padding-left: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 16px;
        text-align: left;
        margin-top: 30px;
      }
      
      .slide-content li {
        position: relative;
        padding-left: 36px;
        background: white;
        padding: 24px 24px 24px 50px;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        color: #1d1d1f;
      }
      
      .slide-section--alt .slide-content li {
        background: white;
      }
      
      .slide-section--dark .slide-content li {
        background: rgba(255, 255, 255, 0.05);
        color: white;
        box-shadow: none;
      }
      
      .slide-content li::before {
        content: "✓";
        position: absolute;
        left: 20px;
        top: 22px;
        color: var(--blue);
        font-weight: bold;
        font-size: 1.2rem;
      }
      
      .slide-section--dark .slide-content li::before {
        color: var(--roomieverse-blue);
      }
      
      .apple-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 40px;
        margin-top: 60px;
      }
      
      .apple-card {
        border-radius: 36px;
        background: #f5f5f7;
        display: flex;
        flex-direction: column;
        padding: 40px;
        gap: 16px;
        transition: transform 0.3s ease;
      }
      
      .apple-card:hover {
        transform: translateY(-8px);
      }
      
      .slide-section--alt .apple-card {
        background: white;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
      }
      
      .slide-section--dark .apple-card {
        background: rgba(255, 255, 255, 0.05);
        color: white;
      }
      
      .apple-card h3 {
        font-size: 1.8rem;
        margin: 0;
        color: inherit;
      }
      
      .apple-card p {
        color: #86868b;
        margin: 0;
        line-height: 1.5;
      }
      
      .slide-section--dark .apple-card p {
        color: rgba(255, 255, 255, 0.7);
      }
      
      .highlight-box {
        background: white;
        border-radius: 32px;
        padding: 40px;
        margin-top: 40px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.04);
        text-align: left;
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
      }
      
      .slide-section--dark .highlight-box {
        background: rgba(255, 255, 255, 0.05);
        box-shadow: none;
      }
      
      .highlight-box p {
        margin: 0;
        color: #1d1d1f;
        font-weight: 600;
        font-size: 1.5rem;
        line-height: 1.4;
        letter-spacing: -0.01em;
      }
      
      .slide-section--dark .highlight-box p {
        color: white;
      }
      
      @media (min-width: 768px) {
        .highlight-box {
          padding: 48px;
        }
        .highlight-box p {
          font-size: 1.8rem;
        }
      }
      
      .reveal {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1), transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
      }
      
      .reveal.is-visible {
        opacity: 1;
        transform: translateY(0);
      }
      
      .delay-100 { transition-delay: 0.1s; }
      .delay-200 { transition-delay: 0.2s; }
      .delay-300 { transition-delay: 0.3s; }
      
      /* Appendix Section (Apple-style expansive card on gray background) */
      .slide-section--appendix {
        max-width: 100%;
        padding-top: 60px;
        padding-bottom: 120px;
      }
      
      .appendix-hero-wrapper {
        position: relative;
        width: 100%;
        max-width: 1360px;
        margin: 0 auto;
        border-radius: 36px;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 20px 60px rgba(7, 23, 51, 0.05);
        border: 1px solid rgba(7, 23, 51, 0.06);
      }
      
      .appendix-hero-img {
        width: 100%;
        height: auto;
        display: block;
        aspect-ratio: 1672 / 941;
        object-fit: contain;
      }
      
      .appendix-hero-text {
        position: absolute;
        top: 38%;
        left: 8.5%;
        transform: translateY(-50%);
        text-align: left;
        width: 48%;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        pointer-events: none;
      }
      
      .appendix-hero-title {
        font-size: clamp(3rem, 6.8vw, 5.8rem);
        font-weight: 900;
        color: #071733;
        line-height: 1.05;
        letter-spacing: -0.04em;
        margin: 0;
        -webkit-text-stroke: 1.2px #071733;
        paint-order: stroke fill;
      }
      
      .appendix-hero-subtitle {
        font-size: clamp(1.4rem, 2.8vw, 2.4rem);
        font-weight: 500;
        color: #86868b;
        letter-spacing: -0.02em;
        margin-top: clamp(8px, 1.4vw, 16px);
        margin-bottom: 0;
      }
      
      /* Apple Accordion (Appendix List) */
      .apple-accordion-list {
        border-top: 1px solid #d2d2d7;
        width: 100%;
      }
      
      .apple-accordion-item {
        border-bottom: 1px solid #d2d2d7;
      }
      
      .apple-accordion-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 24px 0;
        cursor: pointer;
        user-select: none;
        list-style: none;
      }
      
      .apple-accordion-header::-webkit-details-marker {
        display: none;
      }
      
      .apple-accordion-header::marker {
        display: none;
        content: "";
      }
      
      .apple-accordion-title {
        font-size: clamp(1.2rem, 1.8vw, 1.45rem);
        font-weight: 700;
        color: #1d1d1f;
        line-height: 1.35;
        letter-spacing: -0.015em;
        padding-right: 24px;
        transition: color 0.2s ease;
      }
      
      .apple-accordion-header:hover .apple-accordion-title {
        color: #0071e3;
      }
      
      .apple-accordion-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #86868b;
        flex-shrink: 0;
        width: 32px;
        height: 32px;
        transform-origin: center center;
        will-change: transform;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), color 0.25s ease;
      }
      
      .apple-accordion-header:hover .apple-accordion-icon {
        color: #1d1d1f;
      }
      
      .apple-accordion-item[open] > .apple-accordion-header .apple-accordion-icon {
        transform: rotate(180deg);
      }
      
      .apple-accordion-item[open] .apple-accordion-content {
        animation: accordionSlideIn 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      }
      
      @keyframes accordionSlideIn {
        from {
          opacity: 0;
          transform: translateY(-6px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      
      .apple-accordion-content {
        padding: 0 0 28px 0;
        font-size: clamp(1.02rem, 1.4vw, 1.18rem);
        line-height: 1.65;
        color: #1d1d1f;
      }
      
      .apple-accordion-content p {
        margin: 0;
      }
      
      /* Slide 1 Fullscreen Edge-to-edge Hero */
      .slide-hero-fullscreen {
        position: relative;
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0;
        overflow: hidden;
        background: #f0f4fc;
      }
      
      .slide-hero-wrapper {
        position: relative;
        width: 100%;
        margin: 0;
        padding: 0;
      }
      
      .slide-hero-img {
        width: 100%;
        height: auto;
        display: block;
        aspect-ratio: 1672 / 941;
        object-fit: contain;
      }
      
      .slide-hero-content {
        position: absolute;
        top: 42%;
        left: 8%;
        transform: translateY(-50%);
        width: min(560px, 46%);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        pointer-events: none;
      }
      
      .slide-hero-logo {
        height: clamp(40px, 5.5vw, 68px);
        width: auto;
        object-fit: contain;
        margin-bottom: clamp(14px, 2vw, 28px);
        display: block;
      }
      
      .slide-hero-title {
        font-size: clamp(2rem, 3.8vw, 3.3rem);
        font-weight: 800;
        color: #071733;
        line-height: 1.15;
        letter-spacing: -0.035em;
        margin: 0;
        -webkit-text-stroke: 0.8px #071733;
        paint-order: stroke fill;
      }
      
      @media (max-width: 768px) {
        .slide-hero-img {
          min-height: 380px;
          object-fit: cover;
          object-position: 80% center;
        }
        .slide-hero-content {
          top: 50%;
          left: 6%;
          width: 60%;
        }
        .slide-hero-title {
          font-size: clamp(1.6rem, 5vw, 2.2rem);
        }
      }
    </style>
  </head>
  <body>
    <header class="pitch-header">
      <div style="width: 120px;">
        <img src="/brand/roomio.png" alt="roomio logo" style="width: 100%; object-fit: contain;" />
      </div>
      <div class="pitch-badge">Pre-Seed Pitch</div>
    </header>

    <main style="padding-top: 64px;">
      <!-- Slide 1: Mở màn (Full bleed edge-to-edge) -->
      <section class="slide-hero-fullscreen">
        <div class="slide-hero-wrapper">
          <img 
            src="/pitch/hero-cover.webp" 
            alt="roomio - Ứng dụng chốt điện nước & thu tiền trọ" 
            class="slide-hero-img"
            width="1672"
            height="941"
          />
          <div class="slide-hero-content reveal">
            <img src="/brand/roomio.png" alt="roomio Logo" class="slide-hero-logo" />
            <h1 class="slide-hero-title">Ứng dụng chốt điện nước & thu tiền trọ</h1>
          </div>
        </div>
      </section>

      <!-- Slide 2: Nỗi đau thị trường -->
      <section class="slide-section slide-section--alt">
        <div class="slide-container reveal">
          <div style="text-align: center;">
            <h2 class="slide-title">Tràn ngập phần mềm quản lý, nhưng xài cực kỳ ức chế</h2>
          </div>
          <div class="slide-content">
            <p>Sổ tay, Zalo, Excel dần lùi về dĩ vãng. Nhưng sự thay thế lại là một thảm hoạ: Một rừng phần mềm "nhồi nhét" tính năng.</p>
            <div class="highlight-box">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: #ff9500; margin-bottom: 24px; display: block;">
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
              </svg>
              <p><span style="color: #ff9500;">Sự thật phũ phàng:</span> Cách dùng của các app hiện tại còn phức tạp, nhức đầu và cứng nhắc hơn cả việc ghi sổ tay. Người rành công nghệ nhìn còn hoa mắt, huống hồ các cô chú lớn tuổi.</p>
            </div>
            <p style="margin-top: 24px;"><strong>Hệ quả:</strong> Chủ trọ tải app về háo hức, dùng được 3 ngày thì xoá app trong sự bực tức, quay về dùng Zalo + Sổ tay.</p>
          </div>
        </div>
      </section>

      <!-- Slide 3: Giải pháp -->
      <section class="slide-section">
        <div class="slide-container">
          <div class="reveal" style="text-align: center;">
            <h2 class="slide-title">Không phải "Phần mềm", mà là "Luồng vận hành thông suốt"</h2>
          </div>
          
          <div class="apple-grid">
            <article class="apple-card reveal delay-100">
              <h3>Bản chất vấn đề</h3>
              <p>Các app hiện tại cũng có tự động hoá, cũng xuất bill. NHƯNG vì sợ tốn phí Zalo, đối thủ phải "hà tiện" tin nhắn, ép chủ trọ phải tự mò mẫm mở app lên để kiểm tra.</p>
            </article>
            <article class="apple-card reveal delay-200">
              <h3>Cách roomio làm</h3>
              <p>roomio không làm thêm 1 cái "app quản lý" rác. roomio đúc kết một luồng vận hành duy nhất, tiện nhất.</p>
            </article>
            <article class="apple-card reveal delay-300">
              <h3>Vũ khí cốt lõi</h3>
              <p>Khai thác Bot Telegram làm kênh thông báo nội bộ cho Chủ trọ. Bắn thông tin liên tục, tức thì (Tiền về, xuất bill, nợ đọng) với chi phí 0 đồng. Chủ trọ cảm thấy có người đang làm việc thay mình.</p>
            </article>
          </div>
        </div>
      </section>

      <!-- Slide 4: Sự thay đổi cách làm -->
      <section class="slide-section slide-section--dark">
        <div class="slide-container reveal">
          <div style="text-align: center;">
            <h2 class="slide-title">Không chỉ "Số hoá", roomio "Làm thay" chủ trọ</h2>
          </div>
          <div class="slide-content">
            <p>Các phần mềm ngoài kia bắt chủ trọ đi gom số rồi tự gõ tay vào app. roomio thay đổi hoàn toàn bằng cách giao việc cho Bot:</p>
            <ul>
              <li><strong>Chốt điện nước:</strong> Bot tự động nhắc người thuê gửi số qua chat. roomio đọc số, chủ trọ chỉ việc bấm "Duyệt". Không cần đi gõ cửa từng phòng.</li>
              <li><strong>Đòi nợ tự động:</strong> Hệ thống liên tục "nhắc khéo" người thuê đóng tiền cho đến khi hoàn tất. Chủ trọ thoát cảnh đi đòi nợ mệt mỏi.</li>
              <li><strong>Gạch nợ & Báo cáo:</strong> Khách chuyển khoản -> Tự gạch nợ -> Bot nội bộ báo cáo tóm tắt mỗi sáng cho chủ trọ. Chủ trọ không cần mở app lên check.</li>
            </ul>
          </div>
          <div class="highlight-box reveal delay-200">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--roomieverse-blue); margin-bottom: 24px; display: block;">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M2 12h20"></path>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <p><span style="color: var(--roomieverse-blue);">Bức tranh lớn:</span> roomio vận hành như một người quản gia tàng hình, giải phóng chủ trọ khỏi việc nhập liệu tẻ nhạt.</p>
          </div>
        </div>
      </section>

      <!-- Slide 5: Rào cản công nghệ -->
      <section class="slide-section">
        <div class="slide-container">
          <div class="reveal" style="text-align: center;">
            <h2 class="slide-title">Sự khác biệt không nằm ở tính năng, mà ở cách hệ thống giữ cùng một trạng thái.</h2>
          </div>
          
          <div class="slide-content reveal delay-100" style="margin-bottom: 40px;">
            <p><strong>Điểm yếu đối thủ:</strong> Các app hiện tại rất nặng, giao diện cực kỳ phức tạp, bắt chủ trọ phải học rất lâu khiến cô chú lớn tuổi nhanh chóng bỏ cuộc.</p>
          </div>

          <div class="apple-grid">
            <article class="apple-card reveal delay-100">
              <h3>1. Bề mặt sử dụng linh hoạt</h3>
              <p>Web cho chủ trọ, Chat (Telegram/Zalo) cho khách thuê. Mỗi bên chỉ thấy phần việc của mình, không bắt ép tải chung 1 app nặng nề.</p>
            </article>
            <article class="apple-card reveal delay-200">
              <h3>2. Quy trình chung</h3>
              <p>Hoá đơn, thanh toán, nhắc nợ cùng chạy trên một luồng dữ liệu duy nhất, đồng bộ liên tục.</p>
            </article>
            <article class="apple-card reveal delay-300">
              <h3>3. Sổ quỹ linh hoạt</h3>
              <p>Xử lý mượt mà các ca "khó đẻ" của thị trường VN (thu nhiều tài khoản, tiền mặt ngoài luồng, trả góp).</p>
            </article>
          </div>
        </div>
      </section>

      <!-- Slide 6: Demo -->
      <section class="slide-section slide-section--alt">
        <div class="slide-container reveal">
          <div style="text-align: center;">
            <h2 class="slide-title">Đơn giản đến mức cô chú 50 tuổi cũng dùng được</h2>
          </div>
          <div class="slide-content" style="text-align: center;">
            <p>1. Chụp hình đồng hồ điện — 2. Bấm nút Chia sẻ qua Zalo — 3. Hoá đơn hiển thị tuyệt đẹp.</p>
          </div>
          <div class="reveal delay-200" style="width: 100%; max-width: 800px; aspect-ratio: 16/9; background: #1d1d1f; border-radius: 24px; margin: 40px auto 0; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.15);">
            <span>[ Video Demo Thực Tế Sẽ Chèn Tại Đây ]</span>
          </div>
        </div>
      </section>

      <!-- Slide 7: Thị trường -->
      <section class="slide-section">
        <div class="slide-container">
          <div class="reveal" style="text-align: center;">
            <h2 class="slide-title">Khai thác Tệp Tỷ đô bằng mô hình thu phí phần mềm</h2>
          </div>
          
          <div class="slide-content reveal delay-100">
            <ul>
              <li><strong>Thị trường khổng lồ:</strong> Hơn 3 triệu phòng trọ tại VN tạo ra luồng tiền giao dịch hàng tỷ USD mỗi tháng.</li>
              <li><strong>Cách thu tiền:</strong> Thu phí linh hoạt dựa trên số phòng lấp đầy (Trung bình ~120k - 350k/tháng). Tương lai khai thác thêm phí giao dịch.</li>
              <li><strong>Định vị rạch ròi:</strong> roomio giúp chủ nhà tự vận hành tốt hơn, <strong>tuyệt đối KHÔNG</strong> trở thành đơn vị vận hành thay chủ nhà (như Nhatrovn).</li>
              <li><strong>Lợi thế trói chân:</strong> Chi phí chuyển đổi đắt đỏ khiến chủ trọ không thể rời bỏ một khi đã đưa khách thuê vào guồng máy của roomio.</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Slide 8: Chiến thuật -->
      <section class="slide-section slide-section--alt">
        <div class="slide-container">
          <div class="reveal" style="text-align: center;">
            <h2 class="slide-title">Chiến thuật "Đánh Du Kích" & Hòn Tuyết Lăn</h2>
          </div>
          
