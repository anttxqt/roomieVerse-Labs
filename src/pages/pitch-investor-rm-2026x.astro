      .pitch-fee-calc__rent-words:empty {
        display: none;
      }

      .pitch-fee-calc__rent-quick {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 2px;
      }

      .pitch-fee-calc__rent-chip {
        flex: 0 1 auto;
        min-width: 0;
        padding: 6px 10px;
        border: 1px solid #000;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 700;
        line-height: 1.2;
        color: #1d1d1f;
        background: #f4f4f5;
        cursor: pointer;
        transition: background-color 0.15s ease, transform 0.1s ease;
      }

      .pitch-fee-calc__rent-chip:hover {
        background: var(--blue-soft);
      }

      .pitch-fee-calc__rent-chip:active {
        transform: translateY(1px);
      }

      .pitch-fee-calc__rent-chip:focus-visible {
        outline: none;
        box-shadow: 0 0 0 2px var(--blue-bright);
      }

      #slide-5 {
        --slide5-head-col: 36%;
        --slide5-accent-1: #ff9500;
        --slide5-accent-2: #34c759;
        --slide5-accent-3: #7c3aed;
      }

      #slide-5 .slide-title {
        color: var(--blue);
      }

      #slide-5 .apple-grid {
        grid-template-columns: 1fr;
        gap: 16px;
        width: 100%;
        max-width: none;
        margin-left: 0;
        margin-right: 0;
      }

      #slide-5 .apple-grid .apple-card {
        width: 100%;
        box-sizing: border-box;
        background: #fff;
        border: 2px solid #fff;
        box-shadow: none;
        transition: box-shadow 0.2s ease, transform 0.3s ease;
      }

      #slide-5 .apple-grid .apple-card:nth-child(1) {
        box-shadow: inset 0 0 0 1px var(--slide5-accent-1);
      }

      #slide-5 .apple-grid .apple-card:nth-child(1) h3 {
        color: var(--slide5-accent-1);
      }

      #slide-5 .apple-grid .apple-card:nth-child(2) {
        box-shadow: inset 0 0 0 1px var(--slide5-accent-2);
      }

      #slide-5 .apple-grid .apple-card:nth-child(2) h3 {
        color: var(--slide5-accent-2);
      }

      #slide-5 .apple-grid .apple-card:nth-child(3) {
        box-shadow: inset 0 0 0 1px var(--slide5-accent-3);
      }

      #slide-5 .apple-grid .apple-card:nth-child(3) h3 {
        color: var(--slide5-accent-3);
      }

      #slide-5 .apple-grid .apple-card:hover {
        transform: none;
      }

      #slide-5 .apple-grid .apple-card:nth-child(1):hover {
        box-shadow: inset 0 0 0 2px var(--slide5-accent-1);
      }

      #slide-5 .apple-grid .apple-card:nth-child(2):hover {
        box-shadow: inset 0 0 0 2px var(--slide5-accent-2);
      }

      #slide-5 .apple-grid .apple-card:nth-child(3):hover {
        box-shadow: inset 0 0 0 2px var(--slide5-accent-3);
      }

      @media (min-width: 768px) {
        #slide-5 .apple-grid .apple-card {
          display: grid;
          grid-template-columns: var(--slide5-head-col) 1fr;
          align-items: center;
          column-gap: 40px;
        }
      }

      #slide-6 {
        --slide6-title-offset: 24px;
      }

      #slide-6 .slide-title {
        padding-top: var(--slide6-title-offset);
      }

      /* Appendix budget tables (roomio pricing-inspired) */
      .pitch-budget-block {
        margin-top: 32px;
      }

      .pitch-budget-block__title {
        margin: 0 0 12px;
        font-size: clamp(1.2rem, 1.8vw, 1.45rem);
        font-weight: 700;
        color: var(--blue-dark);
        line-height: 1.35;
        letter-spacing: -0.015em;
      }

      .pitch-budget-table-shell {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        overflow: hidden;
        margin-bottom: 8px;
      }

      .pitch-budget-table-scroll {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        max-width: 100%;
      }

      .pitch-budget-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        min-width: 640px;
        font-size: 0.9rem;
      }

      .pitch-budget-table--wide {
        min-width: 720px;
      }

      .pitch-budget-table--cashflow {
        min-width: 680px;
      }

      .pitch-budget-table th {
        padding: 14px 16px;
        font-weight: 700;
        border-bottom: 2px solid #e5e5ea;
        color: #1d1d1f;
        background: transparent;
      }

      .pitch-budget-table td {
        padding: 12px 16px;
        border-bottom: 1px solid #e5e5ea;
        vertical-align: top;
        color: #1d1d1f;
      }

      .pitch-budget-table__num {
        text-align: right;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
      }

      .pitch-budget-table__group td {
        font-weight: 700;
        border-bottom: 1px solid #d2d2d7;
        padding-top: 18px;
      }

      .pitch-budget-table__total td {
        font-weight: 700;
        border-top: 2px solid #e5e5ea;
        border-bottom: none;
      }

      .pitch-budget-table-note {
        margin: 0 0 8px;
        font-size: 0.88rem;
        line-height: 1.5;
        color: #86868b;
      }

      .pitch-budget-assumptions {
        margin: 8px 0 0;
        padding-left: 1.2rem;
        color: #1d1d1f;
        font-size: 1.02rem;
        line-height: 1.55;
      }

      .pitch-budget-assumptions li {
        margin-bottom: 10px;
      }

      .pitch-budget-assumptions li::marker {
        font-size: 0.85em;
      }

      #slide-4 {
        --slide4-row-a-cols: 1fr 1fr;
        --slide4-caption-inset: 0px;
        --pitch-media-aspect-row-a: 4 / 3;
        --pitch-media-aspect-card-3: 16 / 9;
      }

      #slide-4 .slide-4-row-a {
        display: grid;
        grid-template-columns: 1fr;
        gap: 40px;
        margin-top: 60px;
        width: 100%;
        min-width: 0;
      }

      @media (min-width: 768px) {
        #slide-4 .slide-4-row-a {
          grid-template-columns: var(--slide4-row-a-cols);
          gap: 32px;
        }
      }

      #slide-4 .slide-4-media-tile {
        display: flex;
        flex-direction: column;
        gap: 16px;
        min-width: 0;
      }

      #slide-4 .slide-4-media-tile__caption {
        margin: 0;
        text-align: left;
        padding-left: var(--slide4-caption-inset);
        padding-right: var(--slide4-caption-inset);
        font-size: clamp(1rem, 1.35vw, 1.15rem);
        line-height: 1.5;
        color: rgba(255, 255, 255, 0.7);
      }

      #slide-4 .slide-4-media-tile__caption strong {
        color: #ffffff;
        font-weight: 700;
      }

      #slide-4 .pitch-media-slot {
        width: 100%;
        min-width: 0;
      }

      #slide-4 .pitch-media-slot[data-slot="slide-4-card-1"],
      #slide-4 .pitch-media-slot[data-slot="slide-4-card-2"] {
        --pitch-media-aspect: var(--pitch-media-aspect-row-a);
      }

      #slide-4 .pitch-media-slot[data-slot="slide-4-card-3"] {
        --pitch-media-aspect: var(--pitch-media-aspect-card-3);
      }

      #slide-4 .pitch-media-slot__frame {
        aspect-ratio: var(--pitch-media-aspect, 16 / 9);
        width: 100%;
        max-width: 100%;
        border-radius: 28px;
        overflow: hidden;
        position: relative;
        box-sizing: border-box;
        display: grid;
      }

      #slide-4 .pitch-media-slot__frame > :global(picture),
      #slide-4 .pitch-media-slot__frame > .pitch-media-slot__video,
      #slide-4 .pitch-media-slot__frame > .pitch-media-slot__video-poster {
        grid-area: 1 / 1;
        width: 100%;
        height: 100%;
        min-width: 0;
        min-height: 0;
      }

      #slide-4 .pitch-media-slot__frame :global(img),
      #slide-4 .pitch-media-slot__frame :global(picture) {
        display: block;
        width: 100%;
        height: 100%;
      }

      #slide-4 .pitch-media-slot__frame :global(img) {
        object-fit: cover;
        border-radius: 28px;
      }

      #slide-4 .pitch-media-slot__video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        border-radius: 28px;
      }

      #slide-4 .pitch-media-slot__video-poster {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: none;
        pointer-events: none;
      }

      #slide-4 .pitch-media-slot__video-poster :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 28px;
      }

      @media (prefers-reduced-motion: reduce) {
        #slide-4 .pitch-media-slot__video {
          display: none;
        }

        #slide-4 .pitch-media-slot__video-poster {
          display: block;
        }
      }

      #slide-4 .pitch-media-slot__placeholder {
        aspect-ratio: var(--pitch-media-aspect, 16 / 9);
        width: 100%;
        max-width: 100%;
        border-radius: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.55);
        font-size: 0.95rem;
        font-weight: 600;
        text-align: center;
        padding: 16px;
        box-sizing: border-box;
      }

      #slide-4 .slide-4-row-b.highlight-box {
        max-width: none;
        width: 100%;
        margin-left: 0;
        margin-right: 0;
      }

      #slide-4 .slide-4-row-b__inner {
        display: flex;
        flex-direction: column;
        gap: 24px;
        min-width: 0;
      }

      @media (min-width: 768px) {
        #slide-4 .slide-4-row-b__inner {
          flex-direction: row;
          align-items: center;
          gap: 40px;
        }

        #slide-4 .slide-4-row-b__inner > .pitch-media-slot {
          flex: 0 1 42%;
          min-width: 0;
        }

        #slide-4 .slide-4-row-b__text {
          flex: 1;
          min-width: 0;
        }
      }

      #slide-4 .slide-4-row-b h3 {
        margin: 0 0 12px;
        font-size: clamp(1.35rem, 2vw, 1.8rem);
        line-height: 1.2;
        letter-spacing: -0.02em;
        color: #ffffff;
      }

      #slide-4 .slide-4-row-b__text p {
        margin: 0;
        font-size: clamp(1rem, 1.35vw, 1.15rem);
        font-weight: 400;
        line-height: 1.5;
        color: rgba(255, 255, 255, 0.7);
      }

    </style>
  </head>
  <body>
    <header class="pitch-header">
      <div style="width: 120px;">
        <img src="/brand/roomio.png" alt="roomio logo" style="width: 100%; object-fit: contain;" />
      </div>
      <div class="pitch-badge">Pre-Seed Pre-Revenue Pitch</div>
    </header>

    <main style="padding-top: 64px;">
      <!-- Slide 1: Mở màn (Full bleed edge-to-edge) -->
      <section class="slide-hero-fullscreen">
        <div class="slide-hero-wrapper">
          <img 
            src="/pitch/hero-cover.webp" 
            alt="roomio - Hệ thống tự động hoá giúp chủ nhà quản lý phòng cho thuê khoẻ re" 
            class="slide-hero-img"
            width="1672"
            height="941"
          />
          <div class="slide-hero-content">
            <img src="/brand/roomio.png" alt="roomio Logo" class="slide-hero-logo" />
            <h1 class="slide-hero-title">Hệ thống tự động hoá giúp chủ nhà quản lý phòng cho thuê khoẻ re</h1>
          </div>
        </div>
      </section>

      <!-- Slide 2: Nỗi đau thị trường -->
      <section class="slide-section slide-section--white" id="slide-2">
        <div class="slide-container reveal">
          <div style="text-align: center;">
            <h2 class="slide-title" style="color: var(--blue);">Thị trường không thiếu app quản lý, nhưng thiếu một trải nghiệm thực sự trơn tru</h2>
          </div>
          <div class="slide-content">
            <p>Việc ghi sổ tay hay dùng Excel cũng không còn nhiều ở thời điểm hiện tại nữa. Chủ cho thuê đã và đang chuyển dần sang các hệ thống khác để quản lý nhanh hơn, tiện hơn, ít sai sót hơn. Tuy nhiên, sau khi phân tích thị trường sẽ thấy được những sự thay thế hiện nay lại là thảm hoạ: một rừng phần mềm nhồi nhét tính năng nhưng không ai cần, trải nghiệm không tập trung vào đối tượng chính là chủ nhà... roomio sẽ phân tích kỹ hơn ở phụ lục.</p>
          </div>

          <div class="slide-2-highlights">
            <div class="highlight-box">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: #ff9500; margin-bottom: 24px; display: block;">
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
              </svg>
              <p><span style="color: #ff9500;">Sự thật phũ phàng:</span> Cách dùng của các app hiện tại còn phức tạp, nhức đầu và cứng nhắc hơn cả việc ghi sổ tay. Người rành công nghệ nhìn còn hoa mắt, huống chi các cô chú lớn tuổi. Xa hơn là chủ nhà phải trả tiền hàng tháng cho một thứ chẳng giúp họ nhiều hơn là bao.</p>
            </div>
            <div class="highlight-box">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: #ff3b30; margin-bottom: 24px; display: block;">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
              </svg>
              <p><span style="color: #ff3b30;">Hệ quả:</span> Chủ trọ háo hức tải app trên điện thoại, hay đăng ký hệ thống trên máy tính. Dùng được vài hôm thì bỏ app trong sự bực tức, quay về như cũ dùng sổ tay hoặc Excel kèm Zalo. Và từ đó có cái nhìn xấu về thị trường app quản lý phòng.</p>
            </div>
          </div>

          <div class="slide-content">
            <div class="appendix-btn-wrap">
              <button type="button" class="appendix-jump-btn" data-target="appendix-slide-2" aria-label="Xem thêm phụ lục cho Slide 2">
                <span>Xem thêm phụ lục</span>
                <i class="appendix-btn-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="4" x2="12" y2="20"></line>
                    <polyline points="19 13 12 20 5 13"></polyline>
                  </svg>
                </i>
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- Slide 3: Giải pháp -->
      <section class="slide-section slide-section--pattern-corners" id="slide-3">
        <div class="slide-container">
          <div class="reveal" style="text-align: center;">
            <h2 class="slide-title" style="color: var(--blue);">Không chỉ là phần mềm quản lý, roomio sẽ trở thành một luồng vận hành trơn tru</h2>
          </div>
          
          <div class="slide-3-bento">
            <article class="apple-card reveal delay-100">
              <h3>Bản chất vấn đề</h3>
              <p>Các app hiện tại chỉ là nơi ghi số, ghi sổ. Không khác gì một bản Excel khó dùng hơn cả. Chủ cho thuê vẫn phải chạy qua lại giữa khách và app để cập nhật thông tin.</p>
            </article>
            <article class="apple-card reveal delay-200">
              <h3>Cách roomio làm</h3>
              <p>roomio không phải một app quản lý kiểu đó nữa. roomio giúp chủ cho thuê tối đa trong luồng vận hành đó, tự động hoá nhiều nhất có thể.</p>
            </article>

            <div class="highlight-box highlight-box--full-width reveal delay-300">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--blue); margin-bottom: 24px; display: block;">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
              <p><span style="color: var(--blue);">Vậy, roomio khác gì?</span></p>
              <p>Thông tin sẽ tự tìm tới chủ cho thuê thông qua Telegram bot một cách liên tục, tức thì, đều. Từ đó khiến họ cảm thấy có người giúp mình làm việc.</p>
            </div>
          </div>

          <div class="appendix-btn-wrap reveal delay-300">
            <button type="button" class="appendix-jump-btn" data-target="appendix-slide-3" aria-label="Xem thêm phụ lục cho Slide 3">
              <span>Xem thêm phụ lục</span>
              <i class="appendix-btn-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="4" x2="12" y2="20"></line>
                  <polyline points="19 13 12 20 5 13"></polyline>
                </svg>
              </i>
            </button>
          </div>
        </div>
      </section>

      <!-- Slide 4: Sự thay đổi cách làm -->
      <section class="slide-section slide-section--dark" id="slide-4">
        <div class="slide-container reveal">
          <div style="text-align: center;">
            <h2 class="slide-title">Một tháng của chủ cho thuê khi có "roomio"</h2>
          </div>
          <div class="slide-content">
            <p>Các phần mềm hiện tại vẫn để chủ cho thuê đi gom số rồi nhập tay vào app. Chỉ bằng phần mềm thì chưa thể tự động hoàn toàn, nhưng "roomio" đã giao phần việc đó cho một hệ thống chạy ngầm song song với chủ, tự động hoá tới mức cao nhất có thể hiện nay. Và "roomio" vẫn đang tiếp tục giải bài toán đó chứ không dừng lại.</p>
          </div>

          <div class="slide-4-row-a">
            <div class="slide-4-media-tile reveal delay-100">
              <!-- MEDIA SLOT: drop card-1.(png|jpg|webp) or card-1.mp4 + card-1-poster.* into src/assets/pitch/slide-4/ -->
              <div class="pitch-media-slot" data-slot={slide4Slots[0].dataSlot}>
                {
                  slide4Media[0].videoUrl ? (
                    <div class="pitch-media-slot__frame">
                      <video
                        class="pitch-media-slot__video"
                        autoplay
                        muted
                        loop
                        playsinline
                        preload="metadata"
                        poster={slide4Media[0].posterUrl}
                        aria-label={slide4Slots[0].alt}
                      >
                        <source src={slide4Media[0].videoUrl} type="video/mp4" />
                      </video>
                      {slide4Media[0].posterMeta ? (
                        <Picture
                          class="pitch-media-slot__video-poster"
                          src={slide4Media[0].posterMeta}
                          alt={slide4Slots[0].alt}
                          formats={['avif', 'webp']}
                          widths={slide4Slots[0].widths}
                          sizes={slide4Slots[0].sizes}
                          loading="lazy"
                          decoding="async"
                        />
                      ) : null}
                    </div>
                  ) : slide4Media[0].image ? (
                    <div class="pitch-media-slot__frame">
                      <Picture
                        src={slide4Media[0].image}
                        alt={slide4Slots[0].alt}
                        formats={['avif', 'webp']}
                        widths={slide4Slots[0].widths}
                        sizes={slide4Slots[0].sizes}
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  ) : (
                    <div class="pitch-media-slot__placeholder">{slide4Slots[0].placeholder}</div>
                  )
                }
              </div>
              <p class="slide-4-media-tile__caption"><strong>Chốt điện nước.</strong> Người thuê nhận lời nhắc gửi số điện qua chat Telegram, cùng một kênh chat, roomio sẽ tự đọc số, việc duy nhất của chủ cho thuê là xem thử đúng hay không rồi ấn "Duyệt".</p>
            </div>
            <div class="slide-4-media-tile reveal delay-200">
              <!-- MEDIA SLOT: drop card-2.(png|jpg|webp) or card-2.mp4 + card-2-poster.* into src/assets/pitch/slide-4/ -->
              <div class="pitch-media-slot" data-slot={slide4Slots[1].dataSlot}>
                {
                  slide4Media[1].videoUrl ? (
                    <div class="pitch-media-slot__frame">
                      <video
                        class="pitch-media-slot__video"
                        autoplay
                        muted
                        loop
                        playsinline
                        preload="metadata"
                        poster={slide4Media[1].posterUrl}
                        aria-label={slide4Slots[1].alt}
                      >
                        <source src={slide4Media[1].videoUrl} type="video/mp4" />
                      </video>
                      {slide4Media[1].posterMeta ? (
                        <Picture
                          class="pitch-media-slot__video-poster"
                          src={slide4Media[1].posterMeta}
