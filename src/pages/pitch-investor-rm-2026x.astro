    widths: [480, 720, 960],
    sizes:
      '(min-width: 768px) calc((min(100vw - 40px, 1200px) - 96px - 40px) * 0.42), calc(100vw - 120px)',
  },
]

async function resolveSlide4SlotMedia(slot: Slide4SlotConfig) {
  const videoUrl = slide4CardVideo(slot.n)
  const image = slide4CardImage(slot.n)
  const posterMeta = slide4CardPoster(slot.n)
  let posterUrl: string | undefined

  if (posterMeta) {
    const optimized = await getImage({ src: posterMeta, width: slot.widths[slot.widths.length - 1], format: 'webp' })
    posterUrl = optimized.src
  }

  return { videoUrl, image, posterMeta, posterUrl }
}

const slide4Media = await Promise.all(slide4Slots.map((slot) => resolveSlide4SlotMedia(slot)))

