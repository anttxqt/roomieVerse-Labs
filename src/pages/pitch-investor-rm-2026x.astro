async function resolveAppendix2AppSlot(slot: Appendix2AppSlotConfig) {
  const image = appendix2ImageByBase(slot.base)
  let fullUrl: string | undefined

  if (image) {
    const optimized = await getImage({
      src: image,
      width: image.width ? Math.min(image.width, 2560) : 1440,
      format: 'webp',
    })
    fullUrl = optimized.src
  }

  return { ...slot, image, fullUrl }
}

async function resolveAppendix2App(app: Appendix2AppConfig) {
  const slots = await Promise.all(app.slots.map((slot) => resolveAppendix2AppSlot(slot)))
  return { ...app, slots }
}

const appendix2AppsMedia = await Promise.all(appendix2Apps.map((app) => resolveAppendix2App(app)))

