function pitchRateBandIndex(unitPosition) {
  if (unitPosition <= 4) return 0
  if (unitPosition <= 10) return 1
  if (unitPosition <= 25) return 2
  if (unitPosition <= 50) return 3
  if (unitPosition <= 80) return 4
  if (unitPosition <= 100) return 5
  if (unitPosition <= 150) return 6
  if (unitPosition <= 200) return 7
  return 8
}

function pitchRateRow(label) {
  const row = pitchRateMatrix.find((entry) => entry.label === label)
  if (!row) throw new Error(`Unknown pitch rate type: ${label}`)
  return row
}

function pitchRateFullPrice(label, unitCount) {
  const { rates } = pitchRateRow(label)
  let sum = 0
  for (let p = 1; p <= unitCount; p += 1) {
    sum += rates[pitchRateBandIndex(p)]
  }
  return sum
}

function pitchMonthlyFee(label, unitCount, occupancy) {
  const fullPrice = pitchRateFullPrice(label, unitCount)
  return Math.round(fullPrice * (occupancy + (1 - occupancy) * 0.05))
}

function formatPitchPricingVnd(value) {
  return value.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.')
}

function assertPitchPricingData() {
  const checks = [
    ['Nhà trọ', 15, 0.9, 187335],
    ['Nhà trọ', 10, 0.9, 119460],
    ['Căn hộ dịch vụ', 20, 0.9, 514040],
    ['Nhà nguyên căn', 5, 0.9, 150230],
    ['Nhà trọ', 250, 1.0, 5147000],
    ['Nhà trọ', 10, 0.0, 6600],
  ]
  for (const [label, units, occ, expected] of checks) {
    const fee = pitchMonthlyFee(label, units, occ)
    if (fee !== expected) {
      throw new Error(`pitch pricing mismatch for ${label} ${units} occ ${occ}: got ${fee}, expected ${expected}`)
    }
  }
}

assertPitchPricingData()

