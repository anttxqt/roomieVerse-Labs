    <script type="application/json" id="pitch-rate-card" set:html={pitchRateCardJson} />

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const rateCardEl = document.getElementById('pitch-rate-card')
        const calcRoot = document.getElementById('pitch-fee-calc')
        if (!rateCardEl || !calcRoot) return

        const rateCard = JSON.parse(rateCardEl.textContent || '{}')
        const typeSelect = document.getElementById('pitch-fee-type')
        const typeTrigger = document.getElementById('pitch-fee-type-trigger')
        const typeMenu = document.getElementById('pitch-fee-type-menu')
        const typeLabel = typeTrigger?.querySelector('.pitch-fee-calc__select-label')
        const typeChevron = typeTrigger?.querySelector('.pitch-fee-calc__select-chevron')
        const typeOptions = typeMenu
          ? Array.from(typeMenu.querySelectorAll('.pitch-fee-calc__select-option'))
          : []
        const unitsInput = document.getElementById('pitch-fee-units')
        const occInput = document.getElementById('pitch-fee-occ')
        const rentInput = document.getElementById('pitch-fee-rent')
        const unitsValue = document.getElementById('pitch-fee-units-value')
        const occValue = document.getElementById('pitch-fee-occ-value')
        const outMonthly = document.getElementById('pitch-fee-out-monthly')
        const outPerOccupied = document.getElementById('pitch-fee-out-per-occupied')
        const outPct = document.getElementById('pitch-fee-out-pct')
        const rentWords = document.getElementById('pitch-fee-rent-words')

        const RENT_MAX = 50_000_000

        /** Adapted from roomio apps/web/src/lib/number-to-words.ts (MoneyInput.svelte) */
        function numberToVietnameseWords(num) {
          if (num === 0) return 'không'
          if (num < 0) return 'âm ' + numberToVietnameseWords(Math.abs(num))

          const units = ['', 'nghìn', 'triệu', 'tỉ', 'nghìn tỉ', 'triệu tỉ']
          const words = ['không', 'một', 'hai', 'ba', 'bốn', 'năm', 'sáu', 'bảy', 'tám', 'chín']

          function readGroup(n, full) {
            let result = ''
            const hundreds = Math.floor(n / 100)
            const remainder = n % 100
            const tens = Math.floor(remainder / 10)
            const ones = remainder % 10

            if (full || hundreds > 0) {
              result += words[hundreds] + ' trăm '
            }

            if (tens > 1) {
              result += words[tens] + ' mươi '
              if (ones === 1) result += 'mốt '
              else if (ones === 5) result += 'lăm '
              else if (ones > 0) result += words[ones] + ' '
            } else if (tens === 1) {
              result += 'mười '
              if (ones === 5) result += 'lăm '
              else if (ones > 0) result += words[ones] + ' '
            } else if (tens === 0 && ones > 0) {
              if (full || hundreds > 0) {
                result += 'lẻ '
              }
              result += words[ones] + ' '
            }

            return result.trim()
          }

          let result = ''
          let unitIndex = 0
          let n = num

          while (n > 0) {
            const group = n % 1000
            if (group > 0) {
              const groupText = readGroup(group, n > 1000)
              result = groupText + ' ' + units[unitIndex] + ' ' + result
            }
            n = Math.floor(n / 1000)
            unitIndex += 1
          }

          return result.trim().replace(/\s+/g, ' ')
        }

        function formatRentInWords(rent) {
          if (!rent || rent <= 0) return ''
          const spoken = numberToVietnameseWords(Math.round(rent))
          return spoken.charAt(0).toUpperCase() + spoken.slice(1) + ' đồng'
        }

        function clampRent(raw) {
          const n = Number(raw)
          if (!Number.isFinite(n)) return 0
          return Math.min(RENT_MAX, Math.max(0, Math.round(n)))
        }

        function applyRentValue(next) {
          const clamped = clampRent(next)
          rentInput.value = String(clamped)
          recalc()
        }

        const ratesByLabel = Object.fromEntries((rateCard.types || []).map((row) => [row.label, row.rates]))

        let typeMenuOpen = false
        let typeActiveIndex = typeOptions.findIndex(
          (btn) => btn.getAttribute('data-value') === typeSelect?.value
        )

        function syncTypeSelectUi() {
          if (!typeSelect || !typeLabel) return
          const selected = typeSelect.options[typeSelect.selectedIndex]
          typeLabel.textContent = selected?.textContent?.trim() || ''
          typeOptions.forEach((btn) => {
            const isSelected = btn.getAttribute('data-value') === typeSelect.value
            btn.setAttribute('aria-selected', isSelected ? 'true' : 'false')
            btn.classList.toggle('is-selected', isSelected)
            const check = btn.querySelector('.pitch-fee-calc__select-check')
            if (check) check.hidden = !isSelected
          })
        }

        function setTypeMenuOpen(open) {
          if (!typeTrigger || !typeMenu) return
          typeMenuOpen = open
          typeTrigger.setAttribute('aria-expanded', open ? 'true' : 'false')
          typeMenu.hidden = !open
          typeChevron?.classList.toggle('is-open', open)
          if (open) {
            typeActiveIndex = typeOptions.findIndex(
              (btn) => btn.getAttribute('data-value') === typeSelect?.value
            )
            if (typeActiveIndex < 0) typeActiveIndex = 0
            typeOptions.forEach((btn, index) => {
              btn.classList.toggle('is-active', index === typeActiveIndex)
            })
          } else {
            typeOptions.forEach((btn) => btn.classList.remove('is-active'))
          }
        }

        function chooseTypeOption(value) {
          if (!typeSelect) return
          typeSelect.value = value
          syncTypeSelectUi()
          typeSelect.dispatchEvent(new Event('change', { bubbles: true }))
          setTypeMenuOpen(false)
          typeTrigger?.focus()
        }

        function moveTypeActive(direction) {
          if (!typeOptions.length) return
          if (!typeMenuOpen) setTypeMenuOpen(true)
          let next = typeActiveIndex
          for (let attempts = 0; attempts < typeOptions.length; attempts += 1) {
            next = (next + direction + typeOptions.length) % typeOptions.length
            typeActiveIndex = next
            break
          }
          typeOptions.forEach((btn, index) => {
            btn.classList.toggle('is-active', index === typeActiveIndex)
          })
          typeOptions[typeActiveIndex]?.scrollIntoView({ block: 'nearest' })
        }

        if (typeTrigger && typeMenu && typeSelect) {
          syncTypeSelectUi()

          typeTrigger.addEventListener('pointerdown', (event) => {
            event.stopPropagation()
          })

          typeTrigger.addEventListener('click', () => {
            setTypeMenuOpen(!typeMenuOpen)
          })

          typeTrigger.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowDown') {
              event.preventDefault()
              moveTypeActive(1)
            } else if (event.key === 'ArrowUp') {
              event.preventDefault()
              moveTypeActive(-1)
            } else if ((event.key === 'Enter' || event.key === ' ') && typeMenuOpen) {
              event.preventDefault()
              const option = typeOptions[typeActiveIndex]
              if (option) chooseTypeOption(option.getAttribute('data-value') || '')
            } else if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault()
              setTypeMenuOpen(true)
            } else if (event.key === 'Escape') {
              setTypeMenuOpen(false)
            }
          })

          typeMenu.addEventListener('pointerdown', (event) => {
            event.stopPropagation()
          })

          typeOptions.forEach((btn, index) => {
            btn.addEventListener('pointerenter', () => {
              typeActiveIndex = index
              typeOptions.forEach((item, i) => {
                item.classList.toggle('is-active', i === index)
              })
            })
            btn.addEventListener('click', () => {
              chooseTypeOption(btn.getAttribute('data-value') || '')
            })
          })

          document.addEventListener('pointerdown', () => {
            if (typeMenuOpen) setTypeMenuOpen(false)
          })
        }

        function bandIndex(unitPosition) {
          if (unitPosition <= 4) return 0
          if (unitPosition <= 10) return 1
          if (unitPosition <= 25) return 2
          if (unitPosition <= 50) return 3
          if (unitPosition <= 80) return 4
          if (unitPosition <= 100) return 5
          if (unitPosition <= 150) return 6
          if (unitPosition <= 200) return 7
          return 8
        }

        function fullPrice(label, unitCount) {
          const rates = ratesByLabel[label]
          if (!rates) return 0
          let sum = 0
          for (let p = 1; p <= unitCount; p += 1) {
            sum += rates[bandIndex(p)]
          }
          return sum
        }

        function monthlyFee(label, unitCount, occPct) {
          const occ = occPct / 100
          return Math.round(fullPrice(label, unitCount) * (occ + (1 - occ) * 0.05))
        }

        function formatVnd(value) {
          return value.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.')
        }

        function formatPct(value) {
          return value.toFixed(2).replace('.', ',')
        }

        function recalc() {
          const label = typeSelect.value
          const units = Number(unitsInput.value)
          const occPct = Number(occInput.value)
          const rent = clampRent(rentInput.value)
          if (Number(rentInput.value) !== rent) {
            rentInput.value = String(rent)
          }
          const occ = occPct / 100
          const fee = monthlyFee(label, units, occPct)

          unitsValue.textContent = String(units)
          occValue.textContent = `${occPct}%`
          outMonthly.textContent = `${formatVnd(fee)} đ`
          if (rentWords) {
            rentWords.textContent = formatRentInWords(rent)
          }

          if (occ <= 0) {
            outPerOccupied.hidden = true
            outPct.hidden = true
            return
          }

          const perOccupied = Math.round(fee / (units * occ))
          outPerOccupied.hidden = false
          outPerOccupied.textContent = `Trung bình mỗi phòng có khách: ${formatVnd(perOccupied)} đ`

          if (rent <= 0) {
            outPct.hidden = true
            return
          }

          const pct = (fee / (rent * units * occ)) * 100
          outPct.hidden = false
          outPct.textContent = `≈ ${formatPct(pct)}% tiền thuê`
        }

        ;[typeSelect, unitsInput, occInput, rentInput].forEach((el) => {
          el.addEventListener('input', recalc)
          el.addEventListener('change', recalc)
        })

        calcRoot.querySelectorAll('[data-rent-add]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const delta = Number(btn.getAttribute('data-rent-add'))
            if (!Number.isFinite(delta)) return
            applyRentValue((Number(rentInput.value) || 0) + delta)
          })
        })

        recalc()
      })
    </script>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        // Slide 1 Hero Intro Animation: Logo starts in center, scales & moves to target as background fades in
        const heroWrapper = document.querySelector('.slide-hero-wrapper');
        const heroLogo = document.querySelector('.slide-hero-logo');
        const heroImg = document.querySelector('.slide-hero-img');
        const heroTitle = document.querySelector('.slide-hero-title');

        if (heroWrapper && heroLogo && heroImg) {
          const wrapperRect = heroWrapper.getBoundingClientRect();
          const logoRect = heroLogo.getBoundingClientRect();

          const centerX = wrapperRect.left + wrapperRect.width / 2;
          const centerY = wrapperRect.top + wrapperRect.height / 2;
          const logoCenterX = logoRect.left + logoRect.width / 2;
          const logoCenterY = logoRect.top + logoRect.height / 2;

          const deltaX = centerX - logoCenterX;
          const deltaY = centerY - logoCenterY;
          const scale = window.innerWidth <= 768 ? 1.35 : 1.65;

          // Initial state: logo centered & enlarged, background & title hidden
          heroLogo.style.transition = 'none';
          heroLogo.style.transform = `translate3d(${deltaX}px, ${deltaY}px, 0) scale(${scale})`;
          heroImg.style.transition = 'none';
          heroImg.style.opacity = '0';
          if (heroTitle) {
            heroTitle.style.transition = 'none';
            heroTitle.style.opacity = '0';
            heroTitle.style.transform = 'translateY(16px)';
          }

          // Force reflow
          heroLogo.offsetHeight;

          // Animate back to original position while fading in the background
          setTimeout(() => {
            const ease = '1.15s cubic-bezier(0.16, 1, 0.3, 1)';
            heroLogo.style.transition = `transform ${ease}`;
            heroLogo.style.transform = 'translate3d(0, 0, 0) scale(1)';

            heroImg.style.transition = 'opacity 1.25s cubic-bezier(0.16, 1, 0.3, 1)';
            heroImg.style.opacity = '1';

            if (heroTitle) {
              setTimeout(() => {
                heroTitle.style.transition = 'opacity 0.95s cubic-bezier(0.16, 1, 0.3, 1), transform 0.95s cubic-bezier(0.16, 1, 0.3, 1)';
                heroTitle.style.opacity = '1';
                heroTitle.style.transform = 'translateY(0)';
              }, 120);
            }

            // Clean up inline styles after animation finishes
            setTimeout(() => {
              heroLogo.style.transform = '';
              heroLogo.style.transition = '';
              heroImg.style.opacity = '';
              heroImg.style.transition = '';
              if (heroTitle) {
                heroTitle.style.opacity = '';
                heroTitle.style.transform = '';
                heroTitle.style.transition = '';
              }
            }, 1600);
          }, 350);
        }

        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -45px' });

        document.querySelectorAll('.reveal').forEach((element) => {
          revealObserver.observe(element);
        });

        // Jump to appendix dropdown & auto-open
        document.querySelectorAll('.appendix-jump-btn[data-target]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const targetId = btn.getAttribute('data-target');
            const targetDetails = document.getElementById(targetId);
            if (!targetDetails) return;

            // Close all other appendix items
            document.querySelectorAll('.apple-accordion-item').forEach((item) => {
              if (item !== targetDetails) {
                item.open = false;
              }
            });

            // Automatically open dropdown
            targetDetails.open = true;

            // Highlight animation effect: flash title blue then transition back to black
            targetDetails.classList.add('is-target');
            setTimeout(() => targetDetails.classList.remove('is-target'), 2200);

            // Smoothly scroll down to target appendix item
            const tall = targetDetails.offsetHeight > window.innerHeight * 0.8;
            targetDetails.scrollIntoView({ behavior: 'smooth', block: tall ? 'start' : 'center' });
          });
        });

        // Return from appendix item: auto-close dropdown & scroll back to original slide
        document.querySelectorAll('.appendix-jump-btn[data-return]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const returnId = btn.getAttribute('data-return');
            const targetSlide = document.getElementById(returnId);
            const details = btn.closest('details');

            // Scroll up to originating slide
            if (targetSlide) {
              targetSlide.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

            // Close the dropdown cleanly
            if (details) {
              setTimeout(() => {
                details.open = false;
              }, 250);
            }
          });
        });
      });
    </script>
  </body>
</html>
