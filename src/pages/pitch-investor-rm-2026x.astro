        height: 32px;
        transform-origin: center center;
        will-change: transform;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), color 0.25s ease;
      }
      
      .apple-accordion-header:hover .apple-accordion-icon {
        color: #1d1d1f;
      }
      
      .apple-accordion-item[open] > .apple-accordion-header .apple-accordion-icon {
        transform: rotate(180deg);
      }
      
      .apple-accordion-item[open] .apple-accordion-content {
        animation: accordionSlideIn 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      }
      
      @keyframes accordionSlideIn {
        from {
          opacity: 0;
          transform: translateY(-6px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      
      .apple-accordion-content {
        padding: 0 0 28px 0;
        font-size: clamp(1.02rem, 1.4vw, 1.18rem);
        line-height: 1.65;
        color: #1d1d1f;
      }
      
      .apple-accordion-content p {
        margin: 0;
      }

      .apple-accordion-content .pitch-budget-assumptions {
        font-size: inherit;
        line-height: inherit;
      }
      
      /* Slide 1 Fullscreen Edge-to-edge Hero */
      .slide-hero-fullscreen {
        position: relative;
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0;
        overflow: hidden;
        background: #ffffff;
      }
      
      .slide-hero-wrapper {
        position: relative;
        width: 100%;
        margin: 0;
        padding: 0;
      }

      .slide-hero-wrapper::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 160px;
        background: linear-gradient(
          to bottom,
          rgba(255, 255, 255, 0) 0%,
          rgba(255, 255, 255, 0.4) 45%,
          rgba(255, 255, 255, 0.85) 80%,
          #ffffff 100%
        );
        pointer-events: none;
        z-index: 2;
      }
      
      .slide-hero-img {
        width: 100%;
        height: auto;
        display: block;
        aspect-ratio: 1672 / 941;
        object-fit: contain;
        -webkit-mask-image: linear-gradient(
          to bottom,
          #000000 0%,
          #000000 calc(100% - 160px),
          rgba(0, 0, 0, 0.75) calc(100% - 100px),
          rgba(0, 0, 0, 0.3) calc(100% - 40px),
          transparent 100%
        );
        mask-image: linear-gradient(
          to bottom,
          #000000 0%,
          #000000 calc(100% - 160px),
          rgba(0, 0, 0, 0.75) calc(100% - 100px),
          rgba(0, 0, 0, 0.3) calc(100% - 40px),
          transparent 100%
        );
      }
      
      .slide-hero-content {
        position: absolute;
        top: 35%;
        left: 8%;
        transform: translateY(-50%);
        width: min(530px, 46%);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        pointer-events: none;
      }
      
      .slide-hero-logo {
        height: clamp(58px, 7.5vw, 92px);
        width: auto;
        object-fit: contain;
        margin-bottom: clamp(20px, 2.6vw, 30px);
        display: block;
      }
      
      .slide-hero-title {
        font-size: clamp(1.85rem, 3.2vw, 2.75rem);
        font-weight: 700;
        color: #1d1d1f;
        line-height: 1.16;
        letter-spacing: -0.035em;
        margin: 0;
      }
      
      @media (max-width: 768px) {
        .slide-hero-img {
          min-height: 400px;
          object-fit: cover;
          object-position: 18% center;
        }
        .slide-hero-content {
          top: 36%;
          left: 6%;
          width: min(320px, 70%);
        }
        .slide-hero-logo {
          height: clamp(44px, 10vw, 56px);
          margin-bottom: 12px;
        }
        .slide-hero-title {
          font-size: clamp(1.25rem, 4.4vw, 1.65rem);
          line-height: 1.2;
          letter-spacing: -0.03em;
        }
      }

      @media (max-width: 480px) {
        .pitch-header {
          padding: 0 16px;
        }
        .pitch-badge {
          font-size: 11px;
          padding: 3px 8px;
        }
        .slide-hero-img {
          min-height: 390px;
          object-position: 15% center;
        }
        .slide-hero-content {
          top: 35%;
          left: 5%;
          width: min(280px, 72%);
        }
        .slide-hero-logo {
          height: clamp(40px, 11vw, 48px);
          margin-bottom: 10px;
        }
        .slide-hero-title {
          font-size: clamp(1.15rem, 4.8vw, 1.4rem);
          line-height: 1.22;
        }
      }

      /* Appendix Jump & Return Buttons */
      @property --jump-border {
        syntax: "<angle>";
        inherits: false;
        initial-value: 0deg;
      }

      .slide-section, .apple-accordion-item {
        scroll-margin-top: 88px;
      }

      .appendix-btn-wrap {
        display: flex;
        justify-content: center;
        margin-top: 40px;
        width: 100%;
      }

      .appendix-jump-btn {
        display: inline-flex;
        align-items: center;
        gap: 0;
        min-width: 200px;
        min-height: 52px;
        padding: 0 28px;
        box-sizing: border-box;
        justify-content: center;
        border-radius: 999px;
        color: var(--blue-dark, #0a1e4a);
        background: transparent;
        cursor: pointer;
        border: 0;
        position: relative;
        overflow: hidden;
        z-index: 1;
        font-family: var(--font-google-sans, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
        font-size: 1.05rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        text-decoration: none;
        box-shadow: none;
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .appendix-jump-btn:hover {
        transform: translateY(-1px);
        box-shadow: none;
      }

      .appendix-jump-btn:active {
        transform: translateY(1px);
      }

      .appendix-jump-btn::before {
        content: "";
        position: absolute;
        z-index: -2;
        top: -50%; left: -50%; right: -50%; bottom: -50%;
        background: conic-gradient(from 0deg, var(--blue-dark, #0a1e4a) var(--jump-border), rgba(10, 30, 74, 0.12) var(--jump-border), rgba(10, 30, 74, 0.12) 360deg);
        transition: --jump-border 0.5s ease-in-out;
      }

      .appendix-jump-btn:hover::before {
        --jump-border: 360deg;
      }

      .appendix-jump-btn::after {
        content: "";
        position: absolute;
        z-index: -1;
        inset: 2px;
        border-radius: 999px;
        background: #ffffff;
        transition: background-color 0.25s ease;
      }

      .appendix-jump-btn span {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
        transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1), transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
        pointer-events: none;
      }

      .appendix-jump-btn:hover span {
        opacity: 0;
        transform: translateY(16px);
      }

      .appendix-jump-btn--return:hover span {
        opacity: 0;
        transform: translateY(-16px);
      }

      .appendix-btn-icon {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        opacity: 0;
        pointer-events: none;
        color: currentColor;
        transform: translateY(-22px);
        transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      }

      .appendix-jump-btn:hover .appendix-btn-icon {
        opacity: 1;
        transform: translateY(0);
      }

      .appendix-jump-btn--return .appendix-btn-icon {
        transform: translateY(22px);
      }

      .appendix-jump-btn--return:hover .appendix-btn-icon {
        opacity: 1;
        transform: translateY(0);
      }

      /* Dark mode section adaptation */
      .slide-section--dark .appendix-jump-btn {
        color: #ffffff;
        box-shadow: none;
      }

      .slide-section--dark .appendix-jump-btn::before {
        background: conic-gradient(from 0deg, #2997ff var(--jump-border), rgba(255, 255, 255, 0.2) var(--jump-border), rgba(255, 255, 255, 0.2) 360deg);
      }

      .slide-section--dark .appendix-jump-btn::after {
        background: #1c1c1e;
      }

      /* Return button container inside accordion content */
      .appendix-return-wrap {
        margin-top: 20px;
        display: flex;
        justify-content: flex-start;
      }

      .appendix-jump-btn--return {
        min-width: 140px;
        min-height: 48px;
        padding: 0 24px;
        font-size: 0.95rem;
      }

      .appendix-jump-btn--return::after {
        background: #fbfbfd;
      }

      /* Highlight target title animation */
      .apple-accordion-item.is-target .apple-accordion-title {
        animation: appendixTitleHighlight 2.2s cubic-bezier(0.16, 1, 0.3, 1);
      }

      @keyframes appendixTitleHighlight {
