              <summary class="apple-accordion-header">
                <span class="apple-accordion-title">Slide 4: Một tháng của chủ cho thuê</span>
                <span class="apple-accordion-icon" aria-hidden="true">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
