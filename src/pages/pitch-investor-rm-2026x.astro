const slide4ImageGlob = import.meta.glob('../assets/pitch/slide-4/*.{png,jpg,jpeg,webp}', {
  eager: true,
  import: 'default',
}) as Record<string, ImageMetadata>

const slide4VideoGlob = import.meta.glob('../assets/pitch/slide-4/*.mp4', {
  eager: true,
  query: '?url',
  import: 'default',
}) as Record<string, string>

function slide4Basename(path: string) {
  return path.split('/').pop()?.split('?')[0]?.toLowerCase() ?? ''
}

function slide4CardImage(n: number): ImageMetadata | undefined {
  for (const [path, meta] of Object.entries(slide4ImageGlob)) {
    const name = slide4Basename(path)
    if (name === `card-${n}.png` || name === `card-${n}.jpg` || name === `card-${n}.jpeg` || name === `card-${n}.webp`) {
      return meta
    }
  }
  return undefined
}

function slide4CardPoster(n: number): ImageMetadata | undefined {
  for (const [path, meta] of Object.entries(slide4ImageGlob)) {
    const name = slide4Basename(path)
    if (
      name === `card-${n}-poster.png` ||
      name === `card-${n}-poster.jpg` ||
      name === `card-${n}-poster.jpeg` ||
      name === `card-${n}-poster.webp`
    ) {
      return meta
    }
  }
  return slide4CardImage(n)
}

function slide4CardVideo(n: number): string | undefined {
  for (const [path, url] of Object.entries(slide4VideoGlob)) {
    if (slide4Basename(path) === `card-${n}.mp4`) return url
  }
  return undefined
}

