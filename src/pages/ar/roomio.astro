---
import Layout from '../../layouts/Layout.astro'
---

<Layout title="روميو · إدارة العقارات والعمليات" lang="ar">
  <main>
    <div class="carousel-container" id="roomio-carousel" style="padding-top: 180px; padding-bottom: 80px; min-height: 100vh;">
      <div class="carousel-track">
        <!-- Page 1 -->
        <div class="carousel-slide">
          <div class="keynote-grid">
            <!-- Forced Centerpiece -->
            <article class="keynote-card keynote-card--centerpiece reveal" style="display: flex; align-items: center; justify-content: center;">
              <img src="/brand/roomio.png" alt="roomio logo" style="max-width: 70%; max-height: 70%; object-fit: contain;" />
            </article>

            <!-- 1. Big Text -->
            <article class="keynote-card keynote-card--text-hero keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.1s;">
              <h3 class="keynote-gradient-text" style="font-weight: 700;">آلي<br/>بالكامل</h3>
              <p style="margin-top: 12px;">حساب الفواتير وإرسال التذكيرات في الوقت المحدد، في كل مرة.</p>
            </article>

            <!-- 2. Chip -->
            <article class="keynote-card keynote-card--chip keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.15s; flex-direction: column; justify-content: center;">
              <div class="keynote-chip-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
              </div>
              <h3>عقود ذكية</h3>
            </article>

            <!-- 3. Chip -->
            <article class="keynote-card keynote-card--chip keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.2s; flex-direction: column; justify-content: center;">
              <div class="keynote-chip-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
              </div>
              <h3>صلاحيات الموظفين</h3>
            </article>

            <!-- 4. Tall Card -->
            <article class="keynote-card keynote-card--col-2 keynote-card--row-4 reveal" style="transition-delay: 0.25s; justify-content: flex-end; cursor: pointer; border: 2px solid var(--blue);" onclick="document.getElementById('pricing').scrollIntoView({behavior: 'smooth'})">
              <span style="color: var(--blue); font-weight: bold; font-size: 1.5rem; text-align: center; margin-bottom: 20px;">عرض الأسعار<br/>↓</span>
            </article>

            <!-- 5. Chip -->
            <article class="keynote-card keynote-card--chip keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.3s; flex-direction: column; justify-content: center;">
              <div class="keynote-chip-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
              </div>
              <h3>تتبع المشكلات</h3>
            </article>

            <!-- 6. Wide Image Card -->
            <article class="keynote-card keynote-card--col-6 keynote-card--row-2 reveal" style="transition-delay: 0.45s; align-items: center; justify-content: center;">
              <span style="color: #1d1d1f; font-weight: bold; opacity: 0.3; font-size: 1.5rem;">[ تطبيق الجوال ]</span>
            </article>

            <!-- 7. Medium Card -->
            <article class="keynote-card keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.5s; justify-content: flex-end;">
              <span style="color: #1d1d1f; font-weight: bold; opacity: 0.4; font-size: 1.2rem; text-align: center; margin-bottom: 20px;">[ التحليلات ]</span>
            </article>
          </div>
        </div>

        <!-- Page 2 -->
        <div class="carousel-slide">
          <div class="keynote-grid">
            <article class="keynote-card keynote-card--centerpiece reveal" style="transition-delay: 0.05s; display: flex; align-items: center; justify-content: center;">
              <img src="/brand/roomio.png" alt="roomio logo" style="max-width: 70%; max-height: 70%; object-fit: contain;" />
            </article>

            <!-- 1. Big Text -->
            <article class="keynote-card keynote-card--text-hero keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.1s;">
              <h3 class="keynote-gradient-text" style="font-size: 2rem; font-weight: 700;">ميزات<br/>جديدة</h3>
              <p style="margin-top: 12px;">ترقيات مستمرة لتقديم أفضل تجربة.</p>
            </article>

            <!-- 2. Chip -->
            <article class="keynote-card keynote-card--chip keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.15s; flex-direction: column; justify-content: center;">
              <h3>[ الميزة 1 ]</h3>
            </article>

            <!-- 3. Chip -->
            <article class="keynote-card keynote-card--chip keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.2s; flex-direction: column; justify-content: center;">
              <h3>[ الميزة 2 ]</h3>
            </article>

            <!-- 4. Tall Card -->
            <article class="keynote-card keynote-card--col-2 keynote-card--row-4 reveal" style="transition-delay: 0.25s; justify-content: flex-end;">
              <span style="color: #1d1d1f; font-weight: bold; opacity: 0.4; font-size: 1.2rem; text-align: center; margin-bottom: 20px;">[ الميزة 3 ]</span>
            </article>

            <!-- 5. Chip -->
            <article class="keynote-card keynote-card--chip keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.3s; flex-direction: column; justify-content: center;">
              <h3>خطة كبار الشخصيات</h3>
            </article>

            <!-- 6. Wide Image Card -->
            <article class="keynote-card keynote-card--col-6 keynote-card--row-2 reveal" style="transition-delay: 0.45s; align-items: center; justify-content: center;">
              <span style="color: #1d1d1f; font-weight: bold; opacity: 0.3; font-size: 1.5rem;">[ توضيح الميزة ]</span>
            </article>

            <!-- 7. Medium Card -->
            <article class="keynote-card keynote-card--col-2 keynote-card--row-2 reveal" style="transition-delay: 0.5s; justify-content: flex-end;">
              <span style="color: #1d1d1f; font-weight: bold; opacity: 0.4; font-size: 1.2rem; text-align: center; margin-bottom: 20px;">[ إحصائية 5 ]</span>
            </article>
          </div>
        </div>

        <!-- Page 3 -->
        <div class="carousel-slide" style="align-items: center; justify-content: center; padding: 2rem;">
          <h2 style="color: #0071e3; font-weight: 700; font-size: clamp(2rem, 5vw, 4rem); max-width: 900px; line-height: 1.2; margin-bottom: 40px; text-align: center;">
            جرب أسهل طريقة لإدارة العقارات المستأجرة
          </h2>
          <img src="/brand/roomio.png" alt="roomio logo" style="max-height: 100px; margin-bottom: 40px; object-fit: contain;" />
          <div style="display: flex; gap: 20px; align-items: center; justify-content: center; flex-wrap: wrap;">
            <a href="https://roomio.roomieverse.me" target="_blank" class="cta-btn" style="--hover-bg: #0071e3; border: 1px solid #0071e3; color: #0071e3;" onmouseenter="const r=this.getBoundingClientRect(); this.style.setProperty('--x', event.clientX - r.left + 'px'); this.style.setProperty('--y', event.clientY - r.top + 'px');">
              جرب الآن
            </a>
            <a href="https://roomiodemo.roomieverse.me" target="_blank" class="cta-btn" style="--hover-bg: #1d1d1f; border: 1px solid #1d1d1f; color: #1d1d1f;" onmouseenter="const r=this.getBoundingClientRect(); this.style.setProperty('--x', event.clientX - r.left + 'px'); this.style.setProperty('--y', event.clientY - r.top + 'px');">
              شاهد العرض التجريبي
            </a>
          </div>
        </div>
      </div>
      
      <div class="carousel-dots">
        <button class="carousel-dot active" aria-label="Page 1"></button>
        <button class="carousel-dot" aria-label="Page 2"></button>
        <button class="carousel-dot" aria-label="Page 3"></button>
      </div>
      
      <style>
        #roomio-carousel .carousel-arrow {
          color: #1d1d1f;
          background: rgba(0,0,0,0.05);
        }
        #roomio-carousel .carousel-arrow:hover {
          background: rgba(0,0,0,0.1);
        }
      </style>
      <button class="carousel-arrow carousel-arrow--prev" aria-label="السابق" style="display: none;">&#10094;</button>
      <button class="carousel-arrow carousel-arrow--next" aria-label="التالي">&#10095;</button>
    </div>

    <!-- PRICING SECTION -->
    <section id="pricing" style="padding: 120px 20px; max-width: 1200px; margin: 0 auto; background: #fff; color: #1d1d1f;">
      <div style="text-align: center; margin-bottom: 80px;">
        <h2 style="font-size: clamp(2.5rem, 5vw, 4rem); margin-bottom: 20px;">تسعير مرن لكل نطاق</h2>
        <p style="font-size: 1.2rem; color: #86868b; max-width: 700px; margin: 0 auto;">مجاني لأول 6 أشهر للنطاق الصغير. قم بالترقية إلى امتيازات كبار الشخصيات عند تجاوز 50 غرفة.</p>
      </div>

      <div class="apple-grid" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px; margin-bottom: 80px;">
        <!-- Standard -->
        <article style="border-radius: 36px; background: #f5f5f7; display: flex; flex-direction: column; padding: 40px; gap: 16px;">
          <h3 style="font-size: 2rem; margin-bottom: 10px;">أساسي (Standard)</h3>
          <p style="color: #86868b; margin-bottom: 30px;">أقل من 50 غرفة — خدمة ذاتية</p>
          <div style="font-size: 3rem; font-weight: 700; margin-bottom: 10px; display: flex; align-items: baseline; gap: 8px;">
            169k <span style="font-size: 1rem; color: #86868b; font-weight: 400;">فيتنامي/شهر</span>
          </div>
          <p style="font-size: 0.9rem; color: #86868b; margin-bottom: 40px;">يبدأ الفواتير من الغرفة الخامسة. أول 6 أشهر مجانية لـ 1-4 غرف.</p>
          <a href="#" class="cta-btn" style="text-align: center; --hover-bg: #1d1d1f; background: #fff; color: #1d1d1f; border: 1px solid #1d1d1f; margin-bottom: 40px;">ابدأ الإصدار التجريبي المجاني</a>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 16px;">
            <li style="display: flex; gap: 12px; align-items: flex-start;"><span style="color: var(--blue);">✓</span> فواتير وإشعارات آلية</li>
            <li style="display: flex; gap: 12px; align-items: flex-start;"><span style="color: var(--blue);">✓</span> عقود رقمية</li>
            <li style="display: flex; gap: 12px; align-items: flex-start;"><span style="color: var(--blue);">✓</span> تقارير أساسية</li>
            <li style="display: flex; gap: 12px; align-items: flex-start;"><span style="color: var(--blue);">✓</span> أسعار مخفضة للسكن المشترك</li>
          </ul>
        </article>

        <!-- VIP Operator -->
        <article style="border-radius: 36px; background: var(--blue); color: #fff; display: flex; flex-direction: column; padding: 40px; position: relative; overflow: hidden; gap: 16px;">
          <div style="position: absolute; top: 0; right: auto; left: 0; background: var(--pink); color: var(--pink-ink); font-weight: bold; font-size: 0.8rem; padding: 8px 24px; border-bottom-right-radius: 20px;">الأكثر شعبية</div>
          <h3 style="font-size: 2rem; margin-bottom: 10px; color: #fff;">مشغل VIP</h3>
          <p style="color: rgba(255,255,255,0.7); margin-bottom: 30px;">50+ غرفة — امتيازات VIP</p>
          <div style="font-size: 3rem; font-weight: 700; margin-bottom: 10px; display: flex; align-items: baseline; gap: 8px;">
            1,489k <span style="font-size: 1rem; color: rgba(255,255,255,0.7); font-weight: 400;">فيتنامي/شهر</span>
          </div>
          <p style="font-size: 0.9rem; color: rgba(255,255,255,0.7); margin-bottom: 40px;">خصم 50% لأول شهر من التجربة.</p>
          <a href="#" class="cta-btn" style="text-align: center; background: #fff; color: var(--blue); border: none; margin-bottom: 40px;">اتصل بالمبيعات</a>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 16px;">
            <li style="display: flex; gap: 12px; align-items: flex-start;"><span style="color: var(--pink);">✓</span> جميع الميزات الأساسية</li>
            <li style="display: flex; gap: 12px; align-items: flex-start;"><span style="color: var(--pink);">✓</span> إعداد شامل من الألف إلى الياء</li>
            <li style="display: flex; gap: 12px; align-items: flex-start;"><span style="color: var(--pink);">✓</span> دعم VIP مخصص عبر Zalo (رد خلال 5 دقائق)</li>
            <li style="display: flex; gap: 12px; align-items: flex-start;"><span style="color: var(--pink);">✓</span> صلاحيات موظفين متقدمة</li>
            <li style="display: flex; gap: 12px; align-items: flex-start;"><span style="color: var(--pink);">✓</span> تقارير متقدمة للتدفق النقدي والأرباح والخسائر</li>
          </ul>
        </article>
      </div>
      
      <div style="background: #f5f5f7; border-radius: 30px; padding: 40px; display: flex; flex-wrap: wrap; gap: 40px; align-items: center; justify-content: space-between;">
        <div>
          <h4 style="font-size: 1.5rem; margin-bottom: 10px;">سياسة مجمعة / مقسمة ذكية</h4>
          <p style="color: #86868b; max-width: 600px;">للمحافظ المختلطة (أساسي + سكن مشترك)، يقوم Roomio بحساب الخيارين المجمع والمقسم تلقائياً، ويختار لك <strong>الخيار الأرخص</strong> تلقائياً.</p>
        </div>
        <img src="/brand/roomio.png" alt="roomio logo" style="height: 60px; object-fit: contain;" />
      </div>

      <div style="text-align: center; margin-top: 60px;">
        <button onclick="const el = document.getElementById('detailed-pricing'); const isHidden = el.style.display === 'none'; el.style.display = isHidden ? 'block' : 'none'; this.innerText = isHidden ? 'إخفاء التسعير المفصل' : 'عرض التسعير المفصل';" style="background: none; border: none; color: var(--blue); font-size: 1.1rem; cursor: pointer; text-decoration: underline; font-weight: 600;">عرض التسعير المفصل</button>
      </div>

      <div id="detailed-pricing" style="display: none; margin-top: 40px; background: #fff; border-radius: 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); overflow: hidden;">
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; text-align: right;">
            <thead>
              <tr style="background: #f5f5f7;">
                <th style="padding: 20px; font-weight: 600; border-bottom: 2px solid #e5e5ea; min-width: 150px;">الحجم (غرف)</th>
                <th style="padding: 20px; font-weight: 600; border-bottom: 2px solid #e5e5ea; min-width: 200px;">قياسي / شقق</th>
                <th style="padding: 20px; font-weight: 600; border-bottom: 2px solid #e5e5ea; min-width: 200px;">مشاركة / سكن مشترك</th>
              </tr>
            </thead>
            <tbody>
              <tr style="border-bottom: 1px solid #e5e5ea;">
                <td style="padding: 16px 20px; font-weight: 500;">1–4 غرف</td>
                <td style="padding: 16px 20px; color: var(--blue);">أول 6 أشهر مجاناً</td>
                <td style="padding: 16px 20px; color: var(--blue);">أول 6 أشهر مجاناً</td>
              </tr>
              <tr style="border-bottom: 1px solid #e5e5ea;"><td style="padding: 16px 20px;">5–10 غرف</td><td style="padding: 16px 20px;">169,000 ₫ /شهر</td><td style="padding: 16px 20px;">149,000 ₫ /شهر</td></tr>
              <tr style="border-bottom: 1px solid #e5e5ea;"><td style="padding: 16px 20px;">11–20 غرف</td><td style="padding: 16px 20px;">319,000 ₫ /شهر</td><td style="padding: 16px 20px;">290,000 ₫ /شهر</td></tr>
              <tr style="border-bottom: 1px solid #e5e5ea;"><td style="padding: 16px 20px;">21–30 غرف</td><td style="padding: 16px 20px;">499,000 ₫ /شهر</td><td style="padding: 16px 20px;">469,000 ₫ /شهر</td></tr>
              <tr style="border-bottom: 1px solid #e5e5ea;"><td style="padding: 16px 20px;">31–40 غرف</td><td style="padding: 16px 20px;">679,000 ₫ /شهر</td><td style="padding: 16px 20px;">649,000 ₫ /شهر</td></tr>
              <tr style="border-bottom: 1px solid #e5e5ea;"><td style="padding: 16px 20px;">41–50 غرف</td><td style="padding: 16px 20px;">859,000 ₫ /شهر</td><td style="padding: 16px 20px;">819,000 ₫ /شهر</td></tr>
              <tr style="background: var(--blue); color: #fff;">
                <td colspan="3" style="padding: 20px; font-weight: 600; text-align: center; border-bottom: none;">VIP Operator (> 50 غرفة) — امتيازات VIP، خصم 50% الشهر الأول</td>
              </tr>
              <tr style="border-bottom: 1px solid #e5e5ea;"><td style="padding: 16px 20px;">51–70 غرف</td><td colspan="2" style="padding: 16px 20px;">1,489,000 ₫ /شهر</td></tr>
              <tr style="border-bottom: 1px solid #e5e5ea;"><td style="padding: 16px 20px;">71–90 غرف</td><td colspan="2" style="padding: 16px 20px;">1,989,000 ₫ /شهر</td></tr>
              <tr style="border-bottom: 1px solid #e5e5ea;"><td style="padding: 16px 20px;">91–110 غرف</td><td colspan="2" style="padding: 16px 20px;">2,489,000 ₫ /شهر</td></tr>
              <tr style="border-bottom: 1px solid #e5e5ea;"><td style="padding: 16px 20px;">111–150 غرف</td><td colspan="2" style="padding: 16px 20px;">3,289,000 ₫ /شهر</td></tr>
              <tr style="border-bottom: 1px solid #e5e5ea;"><td style="padding: 16px 20px;">151–200 غرف</td><td colspan="2" style="padding: 16px 20px;">4,189,000 ₫ /شهر</td></tr>
              <tr><td style="padding: 16px 20px; font-weight: 500;">أكثر من 200 غرفة</td><td colspan="2" style="padding: 16px 20px; color: var(--pink); font-weight: 500;">اتصل بنا (الشركات)</td></tr>
            </tbody>
          </table>
        </div>
      </div>
  
    </section>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const carousels = document.querySelectorAll('.carousel-container');
        
        carousels.forEach(carousel => {
          const track = carousel.querySelector('.carousel-track');
          const slides = carousel.querySelectorAll('.carousel-slide');
          const dots = carousel.querySelectorAll('.carousel-dot');
          const prevBtn = carousel.querySelector('.carousel-arrow--prev');
          const nextBtn = carousel.querySelector('.carousel-arrow--next');
          
          let currentIndex = 0;
          
          const updateCarousel = () => {
            // Note: Since this is RTL, translateX might need to be positive or handled by Flexbox
            // But usually CSS logical properties or just using LTR for the carousel internals is safer.
            // In a fully RTL environment, transform: translateX(100%) might be needed.
            // Let's use CSS to handle it by keeping it generic.
            const isRTL = document.documentElement.dir === 'rtl';
            track.style.transform = `translateX(${isRTL ? currentIndex * 100 : -currentIndex * 100}%)`;
            
            dots.forEach((dot, index) => {
              dot.classList.toggle('active', index === currentIndex);
            });
            
            if (prevBtn) prevBtn.style.display = currentIndex === 0 ? 'none' : 'flex';
            if (nextBtn) nextBtn.style.display = currentIndex === slides.length - 1 ? 'none' : 'flex';
          };
          
          dots.forEach((dot, index) => {
            dot.addEventListener('click', () => {
              currentIndex = index;
              updateCarousel();
            });
          });
          
          if (prevBtn) {
            prevBtn.addEventListener('click', () => {
              if (currentIndex > 0) {
                currentIndex--;
                updateCarousel();
              }
            });
          }
          
          if (nextBtn) {
            nextBtn.addEventListener('click', () => {
              if (currentIndex < slides.length - 1) {
                currentIndex++;
                updateCarousel();
              }
            });
          }
        });
      });
    </script>
  </main>
</Layout>
