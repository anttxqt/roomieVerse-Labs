---
import Layout from '../../layouts/Layout.astro'
---

<Layout title="فريقنا - Roomieverse Labs" lang="ar">
  <main>
    <section style="padding: 180px 20px 80px; max-width: 1200px; margin: 0 auto; text-align: center;">
      <h1 style="font-size: clamp(3rem, 6vw, 5rem); color: var(--ink);">فريقنا</h1>
    </section>

    <section style="padding: 0 20px 120px; max-width: 1200px; margin: 0 auto;">
      <div style="display: flex; flex-direction: column; align-items: center; gap: 60px;">
        <!-- Member 1 -->
        <article style="display: flex; flex-direction: row; align-items: center; text-align: start; gap: 40px; width: 100%; max-width: 600px;">
          <div style="width: 140px; height: 140px; border-radius: 50%; background: #e5e5ea; flex-shrink: 0; overflow: hidden; display: flex; align-items: center; justify-content: center;">
            <svg width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="#aeaeb2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          </div>
          <div>
            <h3 style="margin-bottom: 4px; font-size: 1.8rem; color: var(--ink);">Antt</h3>
            <p style="color: var(--muted); font-size: 1rem; margin-bottom: 8px;">@antt</p>
            <p style="color: var(--blue); font-weight: 600; font-size: 1.1rem; margin-bottom: 12px;">المؤسس والمدير التنفيذي</p>
            <div style="display: flex; gap: 12px; color: var(--muted);">
              <a href="#" style="color: inherit; text-decoration: none;">X</a>
              <a href="#" style="color: inherit; text-decoration: none;">LinkedIn</a>
            </div>
          </div>
        </article>

        <!-- Member 2 -->
        <article style="display: flex; flex-direction: row; align-items: center; text-align: start; gap: 40px; width: 100%; max-width: 600px;">
          <div style="width: 140px; height: 140px; border-radius: 50%; background: #e5e5ea; flex-shrink: 0; overflow: hidden; display: flex; align-items: center; justify-content: center;">
            <svg width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="#aeaeb2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          </div>
          <div>
            <h3 style="margin-bottom: 4px; font-size: 1.8rem; color: var(--ink);">Antt</h3>
            <p style="color: var(--muted); font-size: 1rem; margin-bottom: 8px;">@antt</p>
            <p style="color: var(--blue); font-weight: 600; font-size: 1.1rem; margin-bottom: 12px;">المطور الرئيسي</p>
            <div style="display: flex; gap: 12px; color: var(--muted);">
              <a href="#" style="color: inherit; text-decoration: none;">X</a>
              <a href="#" style="color: inherit; text-decoration: none;">LinkedIn</a>
            </div>
          </div>
        </article>
        
        <!-- Member 3 -->
        <article style="display: flex; flex-direction: row; align-items: center; text-align: start; gap: 40px; width: 100%; max-width: 600px;">
          <div style="width: 140px; height: 140px; border-radius: 50%; background: #e5e5ea; flex-shrink: 0; overflow: hidden; display: flex; align-items: center; justify-content: center;">
            <svg width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="#aeaeb2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          </div>
          <div>
            <h3 style="margin-bottom: 4px; font-size: 1.8rem; color: var(--ink);">Antt</h3>
            <p style="color: var(--muted); font-size: 1rem; margin-bottom: 8px;">@antt</p>
            <p style="color: var(--blue); font-weight: 600; font-size: 1.1rem; margin-bottom: 12px;">مصمم المنتج</p>
            <div style="display: flex; gap: 12px; color: var(--muted);">
              <a href="#" style="color: inherit; text-decoration: none;">X</a>
              <a href="#" style="color: inherit; text-decoration: none;">LinkedIn</a>
            </div>
          </div>
        </article>
      </div>
    </section>
  </main>
</Layout>
